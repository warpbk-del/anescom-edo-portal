// Расширение «ANESCOM: Подписание З-2» (префикс ану_). Сначала — в копии «ANESCOM-KA 2024».
// Общий модуль ану_ПодписаниеЗ2 (Сервер, НЕ «Вызов сервера», НЕ глобальный). Безопасный режим — выключен (нужен HTTP).
//
// Подписка на событие (в расширении):
//   ану_РеализацияПодписаниеЗ2
//       Источник: ДокументОбъект.РеализацияТоваровУслуг, Событие: ОбработкаПроведения,
//       Обработчик: ану_ПодписаниеЗ2.РеализацияОбработкаПроведения
//
// Что делает: после проведения реализации клиенту фоновое задание формирует печатную форму З-2 в PDF
// и отправляет её на портал ЭДО (POST /dogovor/api/z2). Портал сам находит в Bitrix24 менеджера
// (ответственный сделки по заказу) и кладовщиков склада по городу и рассылает ссылки по очереди:
// менеджер → кладовщик или помощник кладовщика → клиент.
// Повторное проведение без изменений ничего не дублирует; если накладная изменилась — портал
// отменяет старую версию и запускает подписание новой.
//
// ⚠ ПРОВЕРИТЬ В КОНФИГУРАТОРЕ КОПИИ (помечено «ПРОВЕРИТЬ»):
//   1) ИмяМенеджераПечати() и ИдентификаторМакета() — где в КА для Казахстана живёт печать З-2
//      (Документ.РеализацияТоваровУслуг → Печать / команды печати; открыть З-2 из формы реализации
//      и посмотреть идентификатор команды).
//   2) Реквизиты реализации: Менеджер, Склад, ЗаказКлиента, ХозяйственнаяОперация.

#Область НастройкиПодключения

Функция Сервер()
	Возврат "bot.anescom.kz";
КонецФункции

Функция АдресМетода()
	Возврат "/dogovor/api/z2";
КонецФункции

// Токен = EDO_API_TOKEN из D:\anescom_edo\config.env (тот же, что в ану_УведомленияОбОплате).
Функция Токен()
	Возврат "";
КонецФункции

// ПРОВЕРИТЬ: менеджер печати и идентификатор макета формы З-2.
Функция ИмяМенеджераПечати()
	Возврат "Документ.РеализацияТоваровУслуг";
КонецФункции

Функция ИдентификаторМакета()
	Возврат "НакладнаяЗ2";
КонецФункции

#КонецОбласти

#Область ОбработчикПодписки

Процедура РеализацияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт

	Если Отказ Или Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Попытка
		// Только продажа клиенту (передачи на комиссию, возвраты и пр. — нет)
		Если Источник.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.РеализацияКлиенту Тогда
			Возврат;
		КонецЕсли;
		Параметры = Новый Массив;
		Параметры.Добавить(Источник.Ссылка);
		ФоновыеЗадания.Выполнить("ану_ПодписаниеЗ2.Отправить", Параметры,,
			"ANESCOM: З-2 на подпись " + Строка(Источник.Номер));
	Исключение
		ЗаписьЖурналаРегистрации("ANESCOM.ПодписаниеЗ2", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Отправка

// Вызывается фоновым заданием. Ждёт фиксации транзакции проведения (до ~30 с), затем отправляет.
Процедура Отправить(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Токен()) Тогда
		ЗаписьЖурналаРегистрации("ANESCOM.ПодписаниеЗ2", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не задан токен портала — З-2 не отправлена: " + Строка(Ссылка));
		Возврат;
	КонецЕсли;

	Для Попытка_ = 1 По 15 Цикл
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") = Истина Тогда
			Прервать;
		КонецЕсли;
		Пауза(2);
	КонецЦикла;
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен") <> Истина Тогда
		Возврат; // проведение отменилось
	КонецЕсли;

	Попытка
		Данные = ДанныеНакладной(Ссылка);
		Данные.Вставить("body_base64", PDFЗ2(Ссылка));
		ОтправитьНаПортал(Данные);
	Исключение
		ЗаписьЖурналаРегистрации("ANESCOM.ПодписаниеЗ2", УровеньЖурналаРегистрации.Ошибка,, Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ДанныеНакладной(Ссылка)

	Объект = Ссылка.ПолучитьОбъект();
	ИмяКлиента = ?(ЗначениеЗаполнено(Объект.Партнер), Строка(Объект.Партнер), Строка(Объект.Контрагент));

	Телефоны = Новый Массив;
	// «Покупатель розница …» — общий партнёр, телефон не клиента: телефон клиента укажут в кабинете портала
	Если Не СтрНачинаетсяС(НРег(ИмяКлиента), "покупатель розница") Тогда
		ДобавитьТелефоны(Телефоны, Объект.Партнер);
		ДобавитьТелефоны(Телефоны, Объект.Контрагент);
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("external_id", Строка(Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("number", Строка(Объект.Номер));
	Данные.Вставить("title", "Накладная З-2 № " + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy"));
	Данные.Вставить("client_name", ИмяКлиента);
	Данные.Вставить("client_phone", СтрСоединить(Телефоны, ";"));
	Данные.Вставить("warehouse", Строка(Объект.Склад));
	Данные.Вставить("manager_name", Строка(Объект.Менеджер));
	Попытка
		Если ЗначениеЗаполнено(Объект.ЗаказКлиента) Тогда
			Данные.Вставить("order_no", Строка(Объект.ЗаказКлиента.Номер));
		КонецЕсли;
	Исключение
		// реквизита нет или заказов несколько — портал найдёт менеджера по ФИО
	КонецПопытки;
	Возврат Данные;

КонецФункции

// Печатная форма З-2 → PDF → Base64 (стандартный механизм БСП «Печать»).
Функция PDFЗ2(Ссылка)

	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(Ссылка);
	КоллекцияПечатныхФорм = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(ИдентификаторМакета());
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
	ПараметрыПечати = Новый Структура;

	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяМенеджераПечати());
	Менеджер.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);

	ТабДок = Неопределено;
	Для Каждого Форма Из КоллекцияПечатныхФорм Цикл
		Если Форма.ТабличныйДокумент <> Неопределено И Форма.ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабДок = Форма.ТабличныйДокумент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ТабДок = Неопределено Тогда
		ВызватьИсключение "Печатная форма З-2 пустая (проверьте ИдентификаторМакета)";
	КонецЕсли;

	ИмяФайла = ПолучитьИмяВременногоФайла("pdf");
	ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.PDF);
	Двоичные = Новый ДвоичныеДанные(ИмяФайла);
	УдалитьФайлы(ИмяФайла);
	Возврат Base64Строка(Двоичные);

КонецФункции

Процедура ОтправитьНаПортал(Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();

	Соединение = Новый HTTPСоединение(Сервер(), 443,,,, 60, Новый ЗащищенноеСоединениеOpenSSL());
	Запрос = Новый HTTPЗапрос(АдресМетода());
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен());
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Уровень = ?(Ответ.КодСостояния = 200, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка);
	ЗаписьЖурналаРегистрации("ANESCOM.ПодписаниеЗ2", Уровень,,,
		Данные.title + " → " + Ответ.КодСостояния + ": " + Лев(Текст, 800));

КонецПроцедуры

#КонецОбласти

#Область Служебные

Процедура ДобавитьТелефоны(Телефоны, Владелец)

	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат;
	КонецЕсли;
	ИмяТаблицы = Владелец.Метаданные().ПолноеИмя() + ".КонтактнаяИнформация";
	Запрос = Новый Запрос(
		"ВЫБРАТЬ КИ.Представление КАК Представление
		|ИЗ " + ИмяТаблицы + " КАК КИ
		|ГДЕ КИ.Ссылка = &Владелец И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)");
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Представление) И Телефоны.Найти(Выборка.Представление) = Неопределено Тогда
			Телефоны.Добавить(Выборка.Представление);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пауза без нагрузки на процессор: ожидание завершения собственного фонового задания с таймаутом.
Процедура Пауза(Секунд)
	Попытка
		Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
		Если Задание <> Неопределено Тогда
			Задание.ОжидатьЗавершенияВыполнения(Секунд);
		КонецЕсли;
	Исключение
		// таймаут ожидания — это и есть пауза
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
