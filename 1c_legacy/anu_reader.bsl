// Расширение «ANESCOM: Читатель истории» (общий модуль ану_Читатель; Сервер + Вызов сервера).
// Только ЧТЕНИЕ: выгружает документы, табличные части, справочники и обороты регистров
// старой базы (БП 3.0 / УНФ) в текстовые файлы (UTF-8, разделитель — табуляция) в
// D:\anescom_edo\legacy\<bp|unf>\. Дальше сверка БП↔УНФ и загрузка на портал — вне 1С.
// Запуск: общая команда ану_ВыгрузитьИсторию (e1cib/command/ОбщаяКоманда.ану_ВыгрузитьИсторию).

Функция ВыгрузитьВсё() Экспорт
	Папка = ПапкаВыгрузки();
	СоздатьКаталог(Папка);
	Лог = Новый Массив;
	Лог.Добавить("База: " + Метаданные.Имя + " / " + Метаданные.Синоним + " / " + Метаданные.Версия);
	Лог.Добавить("Начало: " + Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'"));

	Для Каждого МД Из Метаданные.Справочники Цикл
		Если ВажныйСправочник(МД.Имя) Тогда
			ВыгрузитьСправочник(МД, Папка, Лог);
		КонецЕсли;
	КонецЦикла;

	Для Каждого МД Из Метаданные.Документы Цикл
		ВыгрузитьДокумент(МД, Папка, Лог);
	КонецЦикла;

	Для Каждого МД Из Метаданные.РегистрыБухгалтерии Цикл
		ВыгрузитьРегистрБухгалтерии(МД, Папка, Лог);
	КонецЦикла;

	Для Каждого МД Из Метаданные.РегистрыНакопления Цикл
		ВыгрузитьРегистрНакопления(МД, Папка, Лог);
	КонецЦикла;

	Лог.Добавить("Конец: " + Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'"));
	Запись = Новый ЗаписьТекста(Папка + "_log.txt", КодировкаТекста.UTF8);
	Запись.Записать(СтрСоединить(Лог, Символы.ПС));
	Запись.Закрыть();
	Возврат "Выгрузка истории готова: " + Папка + " (строк в журнале: " + Лог.Количество() + ")";
КонецФункции

Функция ПапкаВыгрузки()
	Имя = ВРег(Метаданные.Имя + " " + Метаданные.Синоним);
	Если СтрНайти(Имя, "БУХГАЛТЕР") > 0 Тогда
		Код = "bp";
	ИначеЕсли СтрНайти(Имя, "НЕБОЛЬШ") > 0 ИЛИ СтрНайти(Имя, "УНФ") > 0 Тогда
		Код = "unf";
	Иначе
		Код = "base";
	КонецЕсли;
	Возврат "D:\anescom_edo\legacy\" + Код + "\";
КонецФункции

Функция ВажныйСправочник(Имя)
	Список = "Контрагенты,Номенклатура,ДоговорыКонтрагентов,Склады,СтруктурныеЕдиницы,Организации,"
		+ "ПодразделенияОрганизаций,Подразделения,ФизическиеЛица,Сотрудники,СтатьиДвиженияДенежныхСредств,"
		+ "СтатьиДенежныхСредств,Кассы,БанковскиеСчета,НоменклатурныеГруппы,ЕдиницыИзмерения,"
		+ "КлассификаторЕдиницИзмерения,ВидыНоменклатуры,ХарактеристикиНоменклатуры,Партии,"
		+ "ПартииНоменклатуры,СтатьиЗатрат,СтатьиДоходовИРасходов,НаправленияДеятельности,Пользователи";
	Возврат СтрРазделить(Список, ",").Найти(Имя) <> Неопределено;
КонецФункции

Функция КлючевыеРеквизиты()
	Возврат СтрРазделить("Контрагент,Организация,Номенклатура,Договор,ДоговорКонтрагента,Склад,"
		+ "СтруктурнаяЕдиница,Партнер,Заказ,ЗаказПокупателя,ЗаказПоставщику,ДокументОснование,Сделка,"
		+ "Родитель,Владелец,Характеристика,Партия", ",");
КонецФункции

Функция ПоляРеквизитов(Реквизиты, Префикс)
	Ключи = КлючевыеРеквизиты();
	Поля = Новый Массив;
	Для Каждого Р Из Реквизиты Цикл
		Т = Р.Тип;
		Если Т.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			Продолжить;
		КонецЕсли;
		Простой = Т.Типы().Количество() = 1 И (Т.СодержитТип(Тип("Число")) ИЛИ Т.СодержитТип(Тип("Дата"))
			ИЛИ Т.СодержитТип(Тип("Булево")) ИЛИ Т.СодержитТип(Тип("Строка")));
		Если Простой И Т.СодержитТип(Тип("Строка")) И Т.КвалификаторыСтроки.Длина = 0 Тогда
			Поля.Добавить("ПОДСТРОКА(" + Префикс + Р.Имя + ", 1, 300) КАК " + Р.Имя);
		ИначеЕсли Простой Тогда
			Поля.Добавить(Префикс + Р.Имя + " КАК " + Р.Имя);
		ИначеЕсли Т.Типы().Количество() > 5 Тогда
			// составной тип на много объектов (ДокументОснование и т.п.): тип + ключ, без представления
			Поля.Добавить(Префикс + Р.Имя + " КАК " + Р.Имя + "_ref");
		Иначе
			Поля.Добавить("ПРЕДСТАВЛЕНИЕ(" + Префикс + Р.Имя + ") КАК " + Р.Имя);
			Если Ключи.Найти(Р.Имя) <> Неопределено Тогда
				Поля.Добавить(Префикс + Р.Имя + " КАК " + Р.Имя + "_key");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Поля;
КонецФункции

Функция ЕстьЗаписи(ИмяТаблицы)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле ИЗ " + ИмяТаблицы + " КАК Т");
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

Процедура ВыгрузитьСправочник(МД, Папка, Лог)
	Попытка
		Таблица = "Справочник." + МД.Имя;
		Если НЕ ЕстьЗаписи(Таблица) Тогда
			Возврат;
		КонецЕсли;
		Поля = Новый Массив;
		Поля.Добавить("Т.Ссылка КАК Ссылка_key");
		Поля.Добавить("Т.ПометкаУдаления КАК ПометкаУдаления");
		Если МД.ДлинаКода > 0 Тогда
			Поля.Добавить("Т.Код КАК Код");
		КонецЕсли;
		Если МД.ДлинаНаименования > 0 Тогда
			Поля.Добавить("Т.Наименование КАК Наименование");
		КонецЕсли;
		Если МД.Иерархический Тогда
			Поля.Добавить("ПРЕДСТАВЛЕНИЕ(Т.Родитель) КАК Родитель");
			Поля.Добавить("Т.Родитель КАК Родитель_key");
			Если МД.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
				Поля.Добавить("Т.ЭтоГруппа КАК ЭтоГруппа");
			КонецЕсли;
		КонецЕсли;
		Если МД.Владельцы.Количество() > 0 Тогда
			Поля.Добавить("ПРЕДСТАВЛЕНИЕ(Т.Владелец) КАК Владелец");
			Поля.Добавить("Т.Владелец КАК Владелец_key");
		КонецЕсли;
		Для Каждого П Из ПоляРеквизитов(МД.Реквизиты, "Т.") Цикл
			Поля.Добавить(П);
		КонецЦикла;
		Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ " + Таблица + " КАК Т";
		Кол = ВыгрузитьЗапрос(Текст, Папка + "cat_" + МД.Имя + ".tsv");
		Лог.Добавить("cat " + МД.Имя + ": " + Кол);
	Исключение
		Лог.Добавить("ОШИБКА cat " + МД.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Процедура ВыгрузитьДокумент(МД, Папка, Лог)
	Таблица = "Документ." + МД.Имя;
	Попытка
		Если НЕ ЕстьЗаписи(Таблица) Тогда
			Возврат;
		КонецЕсли;
		Поля = Новый Массив;
		Поля.Добавить("Т.Ссылка КАК Ссылка_key");
		Поля.Добавить("Т.Дата КАК Дата");
		Поля.Добавить("Т.Номер КАК Номер");
		Поля.Добавить("Т.Проведен КАК Проведен");
		Поля.Добавить("Т.ПометкаУдаления КАК ПометкаУдаления");
		Для Каждого П Из ПоляРеквизитов(МД.Реквизиты, "Т.") Цикл
			Поля.Добавить(П);
		КонецЦикла;
		Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ " + Таблица + " КАК Т";
		Кол = ВыгрузитьЗапрос(Текст, Папка + "doc_" + МД.Имя + ".tsv");
		Лог.Добавить("doc " + МД.Имя + ": " + Кол);
	Исключение
		Лог.Добавить("ОШИБКА doc " + МД.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
		Попытка
			Поля = Новый Массив;
			Поля.Добавить("Т.Ссылка КАК Ссылка_key");
			Поля.Добавить("Т.НомерСтроки КАК НомерСтроки");
			Для Каждого П Из ПоляРеквизитов(ТЧ.Реквизиты, "Т.") Цикл
				Поля.Добавить(П);
			КонецЦикла;
			Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ " + Таблица + "." + ТЧ.Имя + " КАК Т";
			ИмяФайла = Папка + "ts_" + МД.Имя + "__" + ТЧ.Имя + ".tsv";
			Кол = ВыгрузитьЗапрос(Текст, ИмяФайла);
			Если Кол = 0 Тогда
				УдалитьФайлы(ИмяФайла);
			Иначе
				Лог.Добавить("ts " + МД.Имя + "." + ТЧ.Имя + ": " + Кол);
			КонецЕсли;
		Исключение
			Лог.Добавить("ОШИБКА ts " + МД.Имя + "." + ТЧ.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ВыгрузитьРегистрБухгалтерии(МД, Папка, Лог)
	Попытка
		Если НЕ ЕстьЗаписи("РегистрБухгалтерии." + МД.Имя) Тогда
			Возврат;
		КонецЕсли;
		Поля = Новый Массив;
		Поля.Добавить("О.Период КАК Период");
		Поля.Добавить("О.СчетДт.Код КАК СчетДт");
		Поля.Добавить("О.СчетКт.Код КАК СчетКт");
		Для Каждого Изм Из МД.Измерения Цикл
			Если Изм.Балансовый Тогда
				Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О." + Изм.Имя + ") КАК " + Изм.Имя);
			Иначе
				Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О." + Изм.Имя + "Дт) КАК " + Изм.Имя + "Дт");
				Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О." + Изм.Имя + "Кт) КАК " + Изм.Имя + "Кт");
			КонецЕсли;
		КонецЦикла;
		Для Каждого Р Из МД.Ресурсы Цикл
			Если Р.Балансовый Тогда
				Поля.Добавить("О." + Р.Имя + "Оборот КАК " + Р.Имя);
			Иначе
				Поля.Добавить("О." + Р.Имя + "ОборотДт КАК " + Р.Имя + "Дт");
				Поля.Добавить("О." + Р.Имя + "ОборотКт КАК " + Р.Имя + "Кт");
			КонецЕсли;
		КонецЦикла;
		Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ РегистрБухгалтерии." + МД.Имя
			+ ".ОборотыДтКт(, , Месяц) КАК О";
		Кол = ВыгрузитьЗапрос(Текст, Папка + "acc_" + МД.Имя + ".tsv");
		Лог.Добавить("acc " + МД.Имя + ": " + Кол);
	Исключение
		Лог.Добавить("ОШИБКА acc " + МД.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Обороты с субконто по счетам материалов/товаров/продаж: что именно оприходовано и списано
	Попытка
		Поля = Новый Массив;
		Поля.Добавить("О.Период КАК Период");
		Поля.Добавить("О.Счет.Код КАК Счет");
		Поля.Добавить("О.КорСчет.Код КАК КорСчет");
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О.Субконто1) КАК Субконто1");
		Поля.Добавить("О.Субконто1 КАК Субконто1_key");
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О.Субконто2) КАК Субконто2");
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О.Субконто3) КАК Субконто3");
		Для Каждого Изм Из МД.Измерения Цикл
			Если Изм.Балансовый Тогда
				Поля.Добавить("ПРЕДСТАВЛЕНИЕ(О." + Изм.Имя + ") КАК " + Изм.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Р Из МД.Ресурсы Цикл
			Поля.Добавить("О." + Р.Имя + "ОборотДт КАК " + Р.Имя + "Дт");
			Поля.Добавить("О." + Р.Имя + "ОборотКт КАК " + Р.Имя + "Кт");
		КонецЦикла;
		Счета = Новый Массив;
		МенеджерСчетов = ПланыСчетов[МД.ПланСчетов.Имя];
		Для Каждого Код Из СтрРазделить("1310,1320,1330,1340,1350,6010,7010,8010,8110,8410,1210,3310", ",") Цикл
			Сч = МенеджерСчетов.НайтиПоКоду(Код);
			Если НЕ Сч.Пустая() Тогда
				Счета.Добавить(Сч);
			КонецЕсли;
		КонецЦикла;
		Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ РегистрБухгалтерии." + МД.Имя
			+ ".Обороты(, , Месяц, Счет В ИЕРАРХИИ (&Счета), , , , ) КАК О";
		Кол = ВыгрузитьЗапрос(Текст, Папка + "accsub_" + МД.Имя + ".tsv", Новый Структура("Счета", Счета));
		Лог.Добавить("accsub " + МД.Имя + ": " + Кол);
	Исключение
		Лог.Добавить("ОШИБКА accsub " + МД.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Процедура ВыгрузитьРегистрНакопления(МД, Папка, Лог)
	Попытка
		Если НЕ ЕстьЗаписи("РегистрНакопления." + МД.Имя) Тогда
			Возврат;
		КонецЕсли;
		Поля = Новый Массив;
		Поля.Добавить("О.Период КАК Период");
		Для Каждого П Из ПоляРеквизитов(МД.Измерения, "О.") Цикл
			Поля.Добавить(П);
		КонецЦикла;
		Остатки = МД.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
		Для Каждого Р Из МД.Ресурсы Цикл
			Если Остатки Тогда
				Поля.Добавить("О." + Р.Имя + "Приход КАК " + Р.Имя + "Приход");
				Поля.Добавить("О." + Р.Имя + "Расход КАК " + Р.Имя + "Расход");
			Иначе
				Поля.Добавить("О." + Р.Имя + "Оборот КАК " + Р.Имя + "Оборот");
			КонецЕсли;
		КонецЦикла;
		Текст = "ВЫБРАТЬ " + СтрСоединить(Поля, ", ") + " ИЗ РегистрНакопления." + МД.Имя
			+ ".Обороты(, , Месяц) КАК О";
		Кол = ВыгрузитьЗапрос(Текст, Папка + "reg_" + МД.Имя + ".tsv");
		Лог.Добавить("reg " + МД.Имя + ": " + Кол);
	Исключение
		Лог.Добавить("ОШИБКА reg " + МД.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Функция ВыгрузитьЗапрос(ТекстЗапроса, ИмяФайла, Параметры = Неопределено)
	Запрос = Новый Запрос(ТекстЗапроса);
	Если Параметры <> Неопределено Тогда
		Для Каждого КЗ Из Параметры Цикл
			Запрос.УстановитьПараметр(КЗ.Ключ, КЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Результат = Запрос.Выполнить();
	Колонки = Новый Массив;
	Для Каждого К Из Результат.Колонки Цикл
		Колонки.Добавить(К.Имя);
	КонецЦикла;
	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Колонки, Символы.Таб));
	Выборка = Результат.Выбрать();
	Кол = 0;
	Пока Выборка.Следующий() Цикл
		Ряд = Новый Массив;
		Для Каждого ИмяК Из Колонки Цикл
			Если СтрЗаканчиваетсяНа(ИмяК, "_key") Тогда
				Ряд.Добавить(КлючСсылки(Выборка[ИмяК]));
			ИначеЕсли СтрЗаканчиваетсяНа(ИмяК, "_ref") Тогда
				Ряд.Добавить(ТипИКлюч(Выборка[ИмяК]));
			Иначе
				Ряд.Добавить(ВСтроку(Выборка[ИмяК]));
			КонецЕсли;
		КонецЦикла;
		Запись.ЗаписатьСтроку(СтрСоединить(Ряд, Символы.Таб));
		Кол = Кол + 1;
	КонецЦикла;
	Запись.Закрыть();
	Возврат Кол;
КонецФункции

Функция КлючСсылки(Значение)
	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат ВСтроку(Значение);
	КонецПопытки;
КонецФункции

Функция ТипИКлюч(Значение)
	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Метаданные.НайтиПоТипу(ТипЗнч(Значение)).Имя + ":" + Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат ВСтроку(Значение);
	КонецПопытки;
КонецФункции

Функция ВСтроку(Значение)
	Если Значение = Null ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Т = ТипЗнч(Значение);
	Если Т = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧГ=0; ЧН=0");
	ИначеЕсли Т = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	ИначеЕсли Т = Тип("Булево") Тогда
		Возврат ?(Значение, "1", "0");
	КонецЕсли;
	С = Строка(Значение);
	С = СтрЗаменить(С, Символы.Таб, " ");
	С = СтрЗаменить(С, Символы.ПС, " ");
	С = СтрЗаменить(С, Символы.ВК, " ");
	Возврат С;
КонецФункции
