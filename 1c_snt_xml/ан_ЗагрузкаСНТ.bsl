// Расширение «ЗагрузкаСНТANESCOM». Общий модуль ан_ЗагрузкаСНТ (сервер).
// Загрузка СНТ из XML-файлов, выгруженных с портала ИС ЭСФ
// (контейнер sntInfoContainer / sntInfoSet / sntInfo — тот же формат, что отдаёт API ИС ЭСФ).
// Документы создаются/обновляются типовой функцией Обработки.ОбменСНТ.СоздатьОбновитьПолучаемыеСНТ.

// АдресаФайлов — массив структур (Адрес — адрес во временном хранилище, Имя — имя файла).
// Организация  — отбор списка (может быть пустым).
// Направление  — Перечисления.НаправленияСНТ.
Функция ЗагрузитьИзФайлов(Знач АдресаФайлов, Знач Организация, Знач Направление) Экспорт

	Результат = Новый Структура("Загружено, Сообщения", 0, Новый Массив);

	СтруктурнаяЕдиница = СтруктурнаяЕдиницаПоОрганизации(Организация, Результат.Сообщения);
	Если СтруктурнаяЕдиница = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Обработка = СНТСерверПовтИсп.ОбработкаОбменСНТ();
	Фабрика   = ФабрикаСНТ(Обработка);
	ТипSntInfo = НайтиТипSntInfo(Фабрика);
	Если ТипSntInfo = Неопределено Тогда
		Результат.Сообщения.Добавить("Не найден тип sntInfo в схеме API ИС ЭСФ.");
		Возврат Результат;
	КонецЕсли;

	СписокSntInfo = Новый Массив;

	Для Каждого Файл Из АдресаФайлов Цикл
		Попытка
			Данные = ПолучитьИзВременногоХранилища(Файл.Адрес);
			Текст  = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
			Найдено = 0;
			Чтение = Новый ЧтениеXML;
			Чтение.УстановитьСтроку(Текст);
			Пока Чтение.Прочитать() Цикл
				Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "sntInfo" Тогда
					ДанныеSntInfo = ПрочитатьУзел(Чтение);
					Если ТипЗнч(ДанныеSntInfo) = Тип("Соответствие") Тогда
						SntInfo = Фабрика.Создать(ТипSntInfo);
						ЗаполнитьОбъектXDTO(Фабрика, SntInfo, ДанныеSntInfo);
						СписокSntInfo.Добавить(SntInfo);
						Найдено = Найдено + 1;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Чтение.Закрыть();
			Если Найдено = 0 Тогда
				Результат.Сообщения.Добавить(Файл.Имя + ": в файле не найдено ни одной СНТ (элемент sntInfo).");
			Иначе
				Результат.Сообщения.Добавить(Файл.Имя + ": прочитано СНТ — " + Найдено);
			КонецЕсли;
		Исключение
			Результат.Сообщения.Добавить(Файл.Имя + ": ошибка чтения — " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Если СписокSntInfo.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Обработка.СоздатьОбновитьПолучаемыеСНТ(СписокSntInfo, Направление, СтруктурнаяЕдиница, Истина);
		Результат.Загружено = СписокSntInfo.Количество();
	Исключение
		Результат.Сообщения.Добавить("Ошибка создания документов СНТ: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Фабрика XDTO схемы API ИС ЭСФ для СНТ — как ФабрикаСНТ_XML_API_ЭЦП_Версия1() обработки ОбменСНТ
// (там функция не экспортная, 19.10.2026): макет СхемаСНТ_XML_API_ЭЦП_Версия1 → список XSD → СоздатьФабрикуXDTO.
Функция ФабрикаСНТ(Обработка)

	ТекстовыйМакет = Обработка.ПолучитьМакет("СхемаСНТ_XML_API_ЭЦП_Версия1");
	ОбъектXDTO = ЭСФСервер.ОбъектXDTOИзСтрокиXML(ТекстовыйМакет.ПолучитьТекст(), ФабрикаXDTO);
	СписокXSD = ЭСФСервер.СписокXDTOИзОбъектаXDTO(ОбъектXDTO.Body.querySntV1XsdResponse.xsdList.xsd);

	ИменаФайлов = Новый Массив;
	Для Каждого ТекстXSD Из СписокXSD Цикл
		ИмяФайла = ПолучитьИмяВременногоФайла("xsd");
		ИменаФайлов.Добавить(ИмяФайла);
		Запись = Новый ЗаписьТекста(ИмяФайла);
		Запись.Записать(ТекстXSD);
		Запись.Закрыть();
	КонецЦикла;

	Фабрика = СоздатьФабрикуXDTO(ИменаФайлов);

	Для Каждого ИмяФайла Из ИменаФайлов Цикл
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Фабрика;

КонецФункции

// Читает текущий элемент XML. Возвращает строку (если нет вложенных элементов) или Соответствие.
Функция ПрочитатьУзел(Чтение)

	Если Чтение.ПустойЭлемент Тогда
		Возврат "";
	КонецЕсли;

	Дети  = Новый Соответствие;
	Текст = "";

	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Дети.Вставить(Чтение.ЛокальноеИмя, ПрочитатьУзел(Чтение));
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Или Чтение.ТипУзла = ТипУзлаXML.СекцияCDATA Тогда
			Текст = Текст + Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Дети.Количество() > 0 Тогда
		Возврат Дети;
	Иначе
		Возврат СокрЛП(Текст);
	КонецЕсли;

КонецФункции

// Заполняет объект XDTO по Соответствию (только свойства, которые есть в типе).
Процедура ЗаполнитьОбъектXDTO(Фабрика, Объект, Данные)

	Для Каждого КиЗ Из Данные Цикл

		Свойство = Объект.Тип().Свойства.Получить(КиЗ.Ключ);
		Если Свойство = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Значение = КиЗ.Значение;
		ЭтоОбъект = (ТипЗнч(Свойство.Тип) = Тип("ТипОбъектаXDTO"));

		Если ЭтоОбъект Тогда
			Вложенный = Фабрика.Создать(Свойство.Тип);
			Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
				ЗаполнитьОбъектXDTO(Фабрика, Вложенный, Значение);
			КонецЕсли;
			УстановитьЗначениеСвойства(Объект, Свойство, Вложенный);
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
			ЗначениеXDTO = Неопределено;
			Попытка
				ЗначениеXDTO = Фабрика.Создать(Свойство.Тип, Значение);
			Исключение
				ЗначениеXDTO = Значение;
			КонецПопытки;
			Попытка
				УстановитьЗначениеСвойства(Объект, Свойство, ЗначениеXDTO);
			Исключение
				// свойство не удалось установить — пропускаем, типовой код использует значения по умолчанию
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура УстановитьЗначениеСвойства(Объект, Свойство, Значение)

	Если Свойство.ВерхняяГраница = 1 Тогда
		Объект[Свойство.Имя] = Значение;
	Иначе
		Объект[Свойство.Имя].Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

// Ищет тип объекта sntInfo в фабрике XDTO (по имени типа или по свойству sntInfo у списка).
Функция НайтиТипSntInfo(Фабрика)

	Для Каждого Пакет Из Фабрика.Пакеты Цикл
		Для Каждого ТипXDTO Из Пакет Цикл
			Если ТипЗнч(ТипXDTO) = Тип("ТипОбъектаXDTO") И ВРег(ТипXDTO.Имя) = "SNTINFO" Тогда
				Возврат ТипXDTO;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Пакет Из Фабрика.Пакеты Цикл
		Для Каждого ТипXDTO Из Пакет Цикл
			Если ТипЗнч(ТипXDTO) = Тип("ТипОбъектаXDTO") Тогда
				Свойство = ТипXDTO.Свойства.Получить("sntInfo");
				Если Свойство <> Неопределено И ТипЗнч(Свойство.Тип) = Тип("ТипОбъектаXDTO") Тогда
					Возврат Свойство.Тип;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Структурная единица профиля ИС ЭСФ по организации из отбора списка.
Функция СтруктурнаяЕдиницаПоОрганизации(Организация, Сообщения)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Профили.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница
		|ИЗ
		|	Справочник.ПрофилиИСЭСФ КАК Профили
		|ГДЕ
		|	НЕ Профили.ПометкаУдаления");

	Выборка = Запрос.Выполнить().Выбрать();

	Найдено = Неопределено;
	Всего   = 0;

	Пока Выборка.Следующий() Цикл
		Всего = Всего + 1;
		Если ЗначениеЗаполнено(Организация) Тогда
			Если Выборка.СтруктурнаяЕдиница = Организация Тогда
				Найдено = Выборка.СтруктурнаяЕдиница;
				Прервать;
			КонецЕсли;
			ОргПодр = ЭСФСервер.ОрганизацияИСтруктурноеПодразделение(Выборка.СтруктурнаяЕдиница);
			Если ОргПодр.Организация = Организация Тогда
				Найдено = Выборка.СтруктурнаяЕдиница;
				Прервать;
			КонецЕсли;
		Иначе
			Найдено = Выборка.СтруктурнаяЕдиница;
		КонецЕсли;
	КонецЦикла;

	Если Найдено = Неопределено Тогда
		Сообщения.Добавить("Не найден профиль ИС ЭСФ для организации. Укажите организацию в отборе списка.");
	ИначеЕсли НЕ ЗначениеЗаполнено(Организация) И Всего > 1 Тогда
		Сообщения.Добавить("Профилей ИС ЭСФ несколько — укажите организацию в отборе списка.");
		Найдено = Неопределено;
	КонецЕсли;

	Возврат Найдено;

КонецФункции
