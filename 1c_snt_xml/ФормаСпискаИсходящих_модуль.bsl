// Расширение «ЗагрузкаСНТANESCOM»: модуль заимствованной формы Документ.СНТ.ФормаСпискаИсходящих.
// Кнопка «Загрузить СНТ из XML» на командной панели списка (создаётся программно после типового ПриСозданииНаСервере):
// выбор одного или нескольких XML (выгрузка с портала ИС ЭСФ) → ан_ЗагрузкаСНТ.ЗагрузитьИзФайлов → обновление списка.

&НаСервере
&После("ПриСозданииНаСервере")
Процедура ан_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	Команда = Команды.Добавить("ан_ЗагрузитьСНТИзXML");
	Команда.Заголовок = "Загрузить СНТ из XML";
	Команда.Подсказка = "Загрузить электронные накладные из XML-файлов, выгруженных с портала ИС ЭСФ";
	Команда.Действие = "ан_ЗагрузитьСНТИзXML";

	Родитель = Элементы.Найти("СписокКоманднаяПанель");
	Если Родитель = Неопределено Тогда
		Родитель = Элементы.Список.КоманднаяПанель;
	КонецЕсли;
	Кнопка = Элементы.Добавить("ан_КнопкаЗагрузитьСНТИзXML", Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = "ан_ЗагрузитьСНТИзXML";
	Кнопка.Отображение = ОтображениеКнопки.Текст;

КонецПроцедуры

&НаКлиенте
Процедура ан_ЗагрузитьСНТИзXML(Команда)

	Диалог = Новый ПараметрыДиалогаПомещенияФайлов;
	Диалог.МножественныйВыбор = Истина;
	Диалог.Заголовок = "Выберите XML-файлы СНТ (выгрузка с портала ИС ЭСФ)";
	Диалог.Фильтр = "Файлы XML (*.xml)|*.xml";
	НачатьПомещениеФайловНаСервер(Новый ОписаниеОповещения("ан_ПослеПомещенияФайлов", ЭтотОбъект),,, Диалог,
		УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ан_ПослеПомещенияФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено Или ПомещенныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Адреса = Новый Массив;
	Для Каждого Файл Из ПомещенныеФайлы Цикл
		Адреса.Добавить(Новый Структура("Адрес, Имя", Файл.Адрес, Файл.СсылкаНаФайл.Имя));
	КонецЦикла;

	Результат = ан_ЗагрузитьНаСервере(Адреса, Организация);
	Для Каждого Текст Из Результат.Сообщения Цикл
		Сообщить(Текст);
	КонецЦикла;
	ПоказатьОповещениеПользователя("Загрузка СНТ из XML",, "Загружено (создано или обновлено): " + Результат.Загружено);
	Элементы.Список.Обновить();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ан_ЗагрузитьНаСервере(Знач Адреса, Знач Организация)

	Направление = Неопределено;
	Для Каждого Значение Из Метаданные.Перечисления.НаправленияСНТ.ЗначенияПеречисления Цикл
		Имя = НРег(Значение.Имя);
		Если СтрНайти(Имя, "исход") > 0 Или СтрНайти(Имя, "выдан") > 0 Или СтрНайти(Имя, "отправ") > 0 Тогда
			Направление = Перечисления.НаправленияСНТ[Значение.Имя];
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Направление = Неопределено Тогда
		Сообщения = Новый Массив;
		Сообщения.Добавить("Не найдено направление «исходящие» в перечислении НаправленияСНТ.");
		Возврат Новый Структура("Загружено, Сообщения", 0, Сообщения);
	КонецЕсли;
	Возврат ан_ЗагрузкаСНТ.ЗагрузитьИзФайлов(Адреса, Организация, Направление);

КонецФункции
