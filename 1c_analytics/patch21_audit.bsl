// ===== Патч проекта 21 (аудит 1С за 2026) к общему модулю ану_Аналитика. 24.10.2026 =====
// Только ЧТЕНИЕ данных. Вставить перед строкой «#Область ПроизводствоАВТОКОМП».
// Запуск: ану_АналитикаВызов.ЗапуститьАудит() (общая команда ану_ЗапуститьАудит) — в фоне, 2–10 минут.
// Результат: POST /api/analytics/audit {section, date_from, date_to, replace, rows} → портал /audit (только администратор).
// Разделы: osv (ОСВ по счетам и субконто), unposted (непроведённые / помеченные / будущие документы),
// processor (поступления от переработчика без отчёта), negstock (отрицательные остатки на складах),
// banks (банковские счета: на каких счетах учёта проводятся).

#Область Аудит

Процедура ВыгрузитьАудит(Знач Начало = Неопределено, Знач Конец = Неопределено) Экспорт
	Если Начало = Неопределено Тогда
		Начало = Дата(2026, 1, 1);
	КонецЕсли;
	Если Конец = Неопределено Тогда
		Конец = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	Ошибки = Новый Массив;
	Счетчики = Новый Структура;
	Разделы = СтрРазделить("osv,osv_acc,unposted,processor,negstock", ",");
	Для Каждого Раздел Из Разделы Цикл
		Попытка
			Если Раздел = "osv" Тогда
				Строки = АудитОСВ(Начало, Конец, Истина);
			ИначеЕсли Раздел = "osv_acc" Тогда
				Строки = АудитОСВ(Начало, Конец, Ложь);
			ИначеЕсли Раздел = "unposted" Тогда
				Строки = АудитДокументы(Начало, Конец, Ошибки);
			ИначеЕсли Раздел = "processor" Тогда
				Строки = АудитПереработка(Начало, Конец);
			Иначе
				Строки = АудитОтрицательныеОстатки(Конец, Ошибки);
			КонецЕсли;
			ОтправитьАудит(Раздел, Строки, Начало, Конец);
			Счетчики.Вставить(Раздел, Строки.Количество());
		Исключение
			Ошибки.Добавить(Раздел + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	// ОСВ за 2025 — проверка ввода остатков при переходе на КА (сальдо на 01.01.2025) и итогов года
	Для Каждого Раздел Из СтрРазделить("osv,osv_acc", ",") Цикл
		Попытка
			Строки = АудитОСВ(Дата(2025, 1, 1), КонецДня(Дата(2025, 12, 31)), Раздел = "osv");
			ОтправитьАудит(Раздел + "_2025", Строки, Дата(2025, 1, 1), КонецДня(Дата(2025, 12, 31)));
			Счетчики.Вставить(Раздел + "_2025", Строки.Количество());
		Исключение
			Ошибки.Добавить(Раздел + "_2025: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Итог = Новый Структура("kind,date_from,date_to,counts,errors", "audit_run", ДатаJSON(Начало), ДатаJSON(Конец), Счетчики, Ошибки);
	Попытка
		Отправить("meta", Итог);
	Исключение
		ЗаписьЖурналаРегистрации("ANESCOM.Аудит", УровеньЖурналаРегистрации.Ошибка,,, СтрСоединить(Ошибки, Символы.ПС));
	КонецПопытки;
КонецПроцедуры

Процедура ОтправитьАудит(Раздел, Строки, Начало, Конец)
	Размер = РазмерПорции();
	Всего = Строки.Количество();
	Номер = 0;
	Пока Истина Цикл
		Порция = Новый Массив;
		Для Инд = Номер * Размер По Мин(Всего, (Номер + 1) * Размер) - 1 Цикл
			Порция.Добавить(Строки[Инд]);
		КонецЦикла;
		Тело = Новый Структура("section,date_from,date_to,replace,rows",
			Раздел, ДатаJSON(Начало), ДатаJSON(Конец), Номер = 0, Порция);
		Отправить("audit", Тело);
		Номер = Номер + 1;
		Если Номер * Размер >= Всего Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Имя регистра бухгалтерии регламентированного учёта (в КА для Казахстана — Хозрасчетный).
Функция ИмяРегистраБУ()
	Для Каждого Рег Из Метаданные.РегистрыБухгалтерии Цикл
		Если СтрНайти(Рег.Имя, "Хозрасчетный") > 0 Тогда
			Возврат Рег.Имя;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Рег Из Метаданные.РегистрыБухгалтерии Цикл
		Возврат Рег.Имя;
	КонецЦикла;
	ВызватьИсключение "Нет регистра бухгалтерии";
КонецФункции

// ОСВ за период. СоСубконто = Истина — по счетам денег, расчётов, налогов, капитала с Субконто1/2 (контрагент, договор,
// банковский счёт…); Ложь — все счета, только счёт × организация × подразделение (свёрнутое сальдо).
Функция АудитОСВ(Начало, Конец, СоСубконто)
	ИмяРег = ИмяРегистраБУ();
	МетаРег = Метаданные.РегистрыБухгалтерии[ИмяРег];
	ИмяПлана = МетаРег.ПланСчетов.Имя;
	ЕстьПодразделение = МетаРег.Измерения.Найти("Подразделение") <> Неопределено;
	ЕстьОрганизация = МетаРег.Измерения.Найти("Организация") <> Неопределено;
	ИмяРесурса = "Сумма";
	Если МетаРег.Ресурсы.Найти("Сумма") = Неопределено Тогда
		Для Каждого Рес Из МетаРег.Ресурсы Цикл
			ИмяРесурса = Рес.Имя;
			Прервать;
		КонецЦикла;
	КонецЕсли;

	Поля = "Т.Счет КАК Счет, Т.Счет.Код КАК Код, Т.Счет.Наименование КАК СчетИмя";
	Группы = "Т.Счет, Т.Счет.Код, Т.Счет.Наименование";
	Если ЕстьОрганизация Тогда
		Поля = Поля + ", Т.Организация КАК Организация";
		Группы = Группы + ", Т.Организация";
	КонецЕсли;
	Если ЕстьПодразделение Тогда
		Поля = Поля + ", Т.Подразделение КАК Подразделение";
		Группы = Группы + ", Т.Подразделение";
	КонецЕсли;
	Условие = "";
	Если СоСубконто Тогда
		Поля = Поля + ", Т.Субконто1 КАК Субконто1, Т.Субконто2 КАК Субконто2";
		Группы = Группы + ", Т.Субконто1, Т.Субконто2";
		Условие = "Счет В ИЕРАРХИИ (&Счета)";
	КонецЕсли;
	Р = ИмяРесурса;
	Текст = "ВЫБРАТЬ " + Поля + ",
	|	СУММА(Т." + Р + "НачальныйОстатокДт) КАК НачДт, СУММА(Т." + Р + "НачальныйОстатокКт) КАК НачКт,
	|	СУММА(Т." + Р + "ОборотДт) КАК ОбДт, СУММА(Т." + Р + "ОборотКт) КАК ОбКт,
	|	СУММА(Т." + Р + "КонечныйОстатокДт) КАК КонДт, СУММА(Т." + Р + "КонечныйОстатокКт) КАК КонКт
	|ИЗ
	|	РегистрБухгалтерии." + ИмяРег + ".ОстаткиИОбороты(&Начало, &Конец, , , " + Условие + ", , ) КАК Т
	|СГРУППИРОВАТЬ ПО " + Группы;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Если СоСубконто Тогда
		Счета = Новый Массив;
		Для Каждого Код Из СтрРазделить("1000,1100,1200,1400,1700,3000,3100,3200,3300,3400,3500,5000,0000", ",") Цикл
			Сч = ПланыСчетов[ИмяПлана].НайтиПоКоду(Код);
			Если ЗначениеЗаполнено(Сч) Тогда
				Счета.Добавить(Сч);
			КонецЕсли;
		КонецЦикла;
		Запрос.УстановитьПараметр("Счета", Счета);
	КонецЕсли;

	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("acc", СокрЛП(Выборка.Код));
		С.Вставить("acc_name", СокрЛП(Выборка.СчетИмя));
		С.Вставить("org", ?(ЕстьОрганизация, Строка(Выборка.Организация), ""));
		С.Вставить("dept", ?(ЕстьПодразделение, Строка(Выборка.Подразделение), ""));
		Если СоСубконто Тогда
			С.Вставить("sub1", Строка(Выборка.Субконто1));
			С.Вставить("sub2", Строка(Выборка.Субконто2));
		КонецЕсли;
		С.Вставить("beg_dt", Ч(Выборка.НачДт));
		С.Вставить("beg_kt", Ч(Выборка.НачКт));
		С.Вставить("dt", Ч(Выборка.ОбДт));
		С.Вставить("kt", Ч(Выборка.ОбКт));
		С.Вставить("end_dt", Ч(Выборка.КонДт));
		С.Вставить("end_kt", Ч(Выборка.КонКт));
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// По каждому виду документа с проведением: непроведённые (не помеченные), помеченные на удаление, датированные будущим.
Функция АудитДокументы(Начало, Конец, Ошибки)
	Строки = Новый Массив;
	Завтра = НачалоДня(ТекущаяДатаСеанса()) + 86400;
	Для Каждого Док Из Метаданные.Документы Цикл
		Если Док.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			Продолжить;
		КонецЕсли;
		ЕстьОрг = Док.Реквизиты.Найти("Организация") <> Неопределено;
		Текст = "ВЫБРАТЬ " + ?(ЕстьОрг, "Д.Организация КАК Организация,", "") + "
		|	СУММА(ВЫБОР КОГДА НЕ Д.Проведен И НЕ Д.ПометкаУдаления И Д.Дата МЕЖДУ &Начало И &Конец ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК НеПроведено,
		|	СУММА(ВЫБОР КОГДА Д.ПометкаУдаления И Д.Дата МЕЖДУ &Начало И &Конец ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Помечено,
		|	СУММА(ВЫБОР КОГДА Д.Дата >= &Завтра ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Будущие,
		|	МАКСИМУМ(ВЫБОР КОГДА НЕ Д.Проведен И НЕ Д.ПометкаУдаления И Д.Дата МЕЖДУ &Начало И &Конец ТОГДА Д.Номер ИНАЧЕ """" КОНЕЦ) КАК ПримерНомер,
		|	МАКСИМУМ(ВЫБОР КОГДА Д.Дата >= &Завтра ТОГДА Д.Дата ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1) КОНЕЦ) КАК МаксБудущая
		|ИЗ
		|	Документ." + Док.Имя + " КАК Д
		|ГДЕ
		|	(Д.Дата МЕЖДУ &Начало И &Конец ИЛИ Д.Дата >= &Завтра)
		|" + ?(ЕстьОрг, "СГРУППИРОВАТЬ ПО Д.Организация", "") + "
		|ИМЕЮЩИЕ
		|	СУММА(ВЫБОР КОГДА НЕ Д.Проведен И НЕ Д.ПометкаУдаления И Д.Дата МЕЖДУ &Начало И &Конец ТОГДА 1 ИНАЧЕ 0 КОНЕЦ)
		|	+ СУММА(ВЫБОР КОГДА Д.ПометкаУдаления И Д.Дата МЕЖДУ &Начало И &Конец ТОГДА 1 ИНАЧЕ 0 КОНЕЦ)
		|	+ СУММА(ВЫБОР КОГДА Д.Дата >= &Завтра ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) > 0";
		Попытка
			Запрос = Новый Запрос(Текст);
			Запрос.УстановитьПараметр("Начало", Начало);
			Запрос.УстановитьПараметр("Конец", Конец);
			Запрос.УстановитьПараметр("Завтра", Завтра);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				С = Новый Структура;
				С.Вставить("doc_type", Док.Синоним);
				С.Вставить("doc_name", Док.Имя);
				С.Вставить("org", ?(ЕстьОрг, Строка(Выборка.Организация), ""));
				С.Вставить("unposted", Ч(Выборка.НеПроведено));
				С.Вставить("deleted", Ч(Выборка.Помечено));
				С.Вставить("future", Ч(Выборка.Будущие));
				С.Вставить("sample_no", СокрЛП(Строка(Выборка.ПримерНомер)));
				С.Вставить("max_future", ?(Не ЗначениеЗаполнено(Выборка.МаксБудущая), "", ДатаJSON(Выборка.МаксБудущая)));
				Строки.Добавить(С);
			КонецЦикла;
		Исключение
			Ошибки.Добавить("unposted " + Док.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Поступления от переработчика без «Отчета переработчика» по тому же заказу: сравнение количества продукции по заказам.
Функция АудитПереработка(Начало, Конец)
	МетаОтчет = Метаданные.Документы.ОтчетПереработчика;
	ПолеЗаказаОтчета = "";
	ТЧОтчета = "";
	Для Каждого ТЧ Из МетаОтчет.ТабличныеЧасти Цикл
		Если ТЧ.Реквизиты.Найти("Номенклатура") <> Неопределено И ТЧ.Реквизиты.Найти("Количество") <> Неопределено
			И (СтрНайти(ТЧ.Имя, "Продукц") > 0 Или СтрНайти(ТЧ.Имя, "Издел") > 0 Или СтрНайти(ТЧ.Имя, "Товар") > 0) Тогда
			ТЧОтчета = ТЧ.Имя;
			Если ТЧ.Реквизиты.Найти("ЗаказПереработчику") <> Неопределено Тогда
				ПолеЗаказаОтчета = "Т.ЗаказПереработчику";
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПолеЗаказаОтчета = "" И МетаОтчет.Реквизиты.Найти("ЗаказПереработчику") <> Неопределено Тогда
		ПолеЗаказаОтчета = "Т.Ссылка.ЗаказПереработчику";
	КонецЕсли;
	Если ТЧОтчета = "" Или ПолеЗаказаОтчета = "" Тогда
		ВызватьИсключение "ОтчетПереработчика: не найдена ТЧ продукции или реквизит ЗаказПереработчику";
	КонецЕсли;
	Текст = "ВЫБРАТЬ
	|	П.ЗаказПереработчику КАК Заказ, П.Номенклатура КАК Номенклатура, СУММА(П.Количество) КАК Получено, 0 КАК ВОтчетах,
	|	МАКСИМУМ(П.Ссылка) КАК Документ, МАКСИМУМ(П.Ссылка.Дата) КАК Дата, МАКСИМУМ(П.Ссылка.Организация) КАК Организация
	|ПОМЕСТИТЬ ВТ
	|ИЗ Документ.ПоступлениеОтПереработчика.Товары КАК П
	|ГДЕ П.Ссылка.Проведен И П.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|СГРУППИРОВАТЬ ПО П.ЗаказПереработчику, П.Номенклатура
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ " + ПолеЗаказаОтчета + ", Т.Номенклатура, 0, СУММА(Т.Количество), НЕОПРЕДЕЛЕНО, ДАТАВРЕМЯ(1, 1, 1), НЕОПРЕДЕЛЕНО
	|ИЗ Документ.ОтчетПереработчика." + ТЧОтчета + " КАК Т
	|ГДЕ Т.Ссылка.Проведен
	|СГРУППИРОВАТЬ ПО " + ПолеЗаказаОтчета + ", Т.Номенклатура
	|;
	|ВЫБРАТЬ ВТ.Заказ КАК Заказ, ВТ.Номенклатура КАК Номенклатура, СУММА(ВТ.Получено) КАК Получено, СУММА(ВТ.ВОтчетах) КАК ВОтчетах,
	|	МАКСИМУМ(ВТ.Документ) КАК Документ, МАКСИМУМ(ВТ.Дата) КАК Дата, МАКСИМУМ(ВТ.Организация) КАК Организация
	|ИЗ ВТ КАК ВТ
	|СГРУППИРОВАТЬ ПО ВТ.Заказ, ВТ.Номенклатура
	|ИМЕЮЩИЕ СУММА(ВТ.Получено) > 0 И СУММА(ВТ.Получено) <> СУММА(ВТ.ВОтчетах)";
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("order", Строка(Выборка.Заказ));
		С.Вставить("item", Строка(Выборка.Номенклатура));
		С.Вставить("received", Ч(Выборка.Получено));
		С.Вставить("reported", Ч(Выборка.ВОтчетах));
		С.Вставить("last_receipt", Строка(Выборка.Документ));
		С.Вставить("date", ?(ЗначениеЗаполнено(Выборка.Дата), ДатаJSON(Выборка.Дата), ""));
		С.Вставить("org", Строка(Выборка.Организация));
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Отрицательные остатки на конец периода: ТоварыНаСкладах (склад × номенклатура) и ТоварыОрганизаций (организация × номенклатура).
Функция АудитОтрицательныеОстатки(Конец, Ошибки)
	Строки = Новый Массив;
	Для Каждого ИмяРег Из СтрРазделить("ТоварыНаСкладах,ТоварыОрганизаций", ",") Цикл
		МетаРег = Метаданные.РегистрыНакопления.Найти(ИмяРег);
		Если МетаРег = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ресурс = ?(МетаРег.Ресурсы.Найти("ВНаличии") <> Неопределено, "ВНаличии", "Количество");
		Разрез = ?(МетаРег.Измерения.Найти("Склад") <> Неопределено, "Склад",
			?(МетаРег.Измерения.Найти("Организация") <> Неопределено, "Организация", ""));
		Если МетаРег.Ресурсы.Найти(Ресурс) = Неопределено Или Разрез = "" Тогда
			Ошибки.Добавить("negstock " + ИмяРег + ": нет ресурса/разреза");
			Продолжить;
		КонецЕсли;
		Текст = "ВЫБРАТЬ Т." + Разрез + " КАК Разрез, Т.Номенклатура КАК Номенклатура, Т." + Ресурс + "Остаток КАК Остаток
		|ИЗ РегистрНакопления." + ИмяРег + ".Остатки(&Конец) КАК Т
		|ГДЕ Т." + Ресурс + "Остаток < 0";
		Попытка
			Запрос = Новый Запрос(Текст);
			Запрос.УстановитьПараметр("Конец", Новый Граница(Конец, ВидГраницы.Включая));
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				С = Новый Структура;
				С.Вставить("register", ИмяРег);
				С.Вставить("where", Строка(Выборка.Разрез));
				С.Вставить("item", Строка(Выборка.Номенклатура));
				С.Вставить("qty", Ч(Выборка.Остаток));
				Строки.Добавить(С);
			КонецЦикла;
		Исключение
			Ошибки.Добавить("negstock " + ИмяРег + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Строки;
КонецФункции

Функция Ч(Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

#КонецОбласти

