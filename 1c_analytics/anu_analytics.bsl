// Расширение «ANESCOM: Аналитика» (префикс ану_). Портал v4, этап A. Сначала — в копии базы на 172.16.125.199.
// Общий модуль ану_Аналитика (Сервер, НЕ «Вызов сервера», НЕ глобальный). Безопасный режим расширения — выключен (нужен HTTP).
//
// Регламентное задание (в расширении):
//   ану_ВыгрузкаАналитики — Метод: ану_Аналитика.ану_ВыгрузкаАналитики (вызывает ВыгрузитьРегламентно), расписание: каждые 15 минут
//       (Использование включить после проверки диагностики и ввода токена).
//   ану_ЗакрытиеСделокБ24 — Метод: ану_Аналитика.ану_ЗакрытиеСделокБ24, каждые 900 с (сделки Bitrix24 по закрытым заказам, 23.10.2026).
//   ану_ДиагностикаАналитики — Метод: ану_Аналитика.ану_ДиагностикаАналитики (вызывает Диагностика), Использование: нет; запускать вручную
//       («Регламентные и фоновые задания» → «Выполнить сейчас»).
//
// Что делает: шлёт на портал EDO.ANESCOM (POST /api/analytics/<вид>, Bearer EDO_API_TOKEN) данные для дашбордов:
//   sales    — продажи по дням (реализации минус возвраты), с себестоимостью;
//   payments — поступления от клиентов: наличные (ПКО), карта (операция по платёжной карте), безнал;
//   cashflow — движение денег по статьям ДДС (приход/расход);
//   stock    — остатки по складам + дата последней продажи и продажи за 30/90 дней (для дозаказа и неликвида);
//   debts    — долги клиентов и переплаты;
//   debts_hist — долги и переплаты на 31.12 каждого закрытого года (с НачалоИстории), 19.10.2026.
//   partners — клиенты/поставщики/контрагенты/контактные лица с телефонами, e-mail, бизнес-регионом (снимок, проект 19, 23.10.2026);
//   order_clients — клиент каждого заказа клиента (за период) — сверка сделок Bitrix24 с 1С.
// Каждый запуск берёт последние 3 дня (правки задним числом подтягиваются), портал заменяет присланный период целиком.
// Первоначальная загрузка истории — ВыгрузитьЗаПериод(Дата(2025,1,1), ТекущаяДата()) из консоли/обработки.
// После каждого запуска шлёт «meta» с числом строк и ошибками — их видно на портале /api/analytics/meta.
//
// ⚠ ПРОВЕРИТЬ по результату Диагностика() (поля КА 2.4 для Казахстана, помечены «ПРОВЕРИТЬ»):
//   регистр ВыручкаИСебестоимостьПродаж (себестоимость), ТоварыНаСкладах, РасчетыСКлиентами;
//   реквизит Подразделение у ПКО/безнала/карты; ТЧ РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.

#Область НастройкиПодключения

// На сервере портала (LOGIKAL, 172.16.125.199 — там же копия базы) — напрямую 127.0.0.1:8096 без TLS.
Функция ЛокальныйСервер()
	Возврат ВРег(ИмяКомпьютера()) = "LOGIKAL";
КонецФункции

// Токен = EDO_API_TOKEN из D:\anescom_edo\config.env (тот же, что в ану_ПодписаниеЗ2). Вводит пользователь.
Функция Токен()
	Возврат "";
КонецФункции

// Источник данных для портала: anescom — основная база (есть организация ANESCOM/АНЕСКОМ), иначе avtokomp.
// Одно и то же расширение ставится в обе базы; портал хранит данные АВТОКОМП в отдельных таблицах (18.10.2026).
Функция Источник() Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Ссылка
	|ИЗ
	|	Справочник.Организации КАК О
	|ГДЕ
	|	(О.Наименование ПОДОБНО ""%ANESCOM%"" ИЛИ О.Наименование ПОДОБНО ""%АНЕСКОМ%"")");
	Возврат ?(Запрос.Выполнить().Пустой(), "avtokomp", "anescom");
КонецФункции

// С какой даты грузить историю: АВТОКОМП — с 2024 года, ANESCOM — с 2025.
Функция НачалоИстории() Экспорт
	Возврат ?(Источник() = "avtokomp", Дата(2024, 1, 1), Дата(2025, 1, 1));
КонецФункции

Функция РазмерПорции()
	Возврат 5000;
КонецФункции

Функция ДнейНазад()
	Возврат 3;
КонецФункции

#КонецОбласти

#Область ТочкиВхода

// Регламентное задание каждые 15 минут.
Процедура ВыгрузитьРегламентно() Экспорт
	Конец = КонецДня(ТекущаяДатаСеанса());
	Начало = НачалоДня(Конец - ДнейНазад() * 86400);
	Выгрузить(Начало, Конец, Истина);
КонецПроцедуры

// Загрузка истории по месяцам: ВыгрузитьЗаПериод(Дата(2025,1,1), ТекущаяДата()).
Процедура ВыгрузитьЗаПериод(Знач Начало, Знач Конец) Экспорт
	Начало = НачалоДня(Начало);
	Конец = КонецДня(Конец);
	Месяц = НачалоМесяца(Начало);
	Пока Месяц <= Конец Цикл
		Н = Макс(Месяц, Начало);
		К = Мин(КонецМесяца(Месяц), Конец);
		Выгрузить(Н, К, К = Конец); // снимки (остатки, долги) — только один раз, на последнем месяце
		Месяц = ДобавитьМесяц(Месяц, 1);
	КонецЦикла;
КонецПроцедуры

// Описание метаданных базы (реквизиты нужных документов и регистров) → портал /api/analytics/meta.
// Запустить один раз после установки расширения в копии, чтобы сверить поля запросов.
Процедура Диагностика() Экспорт

	Отчет = Новый Структура;
	Отчет.Вставить("kind", "diagnostics");
	Отчет.Вставить("base", СтрокаСоединенияИнформационнойБазы());
	Отчет.Вставить("config", Метаданные.Имя + " " + Метаданные.Версия);
	Отчет.Вставить("computer", ИмяКомпьютера());

	Документы_ = Новый Массив;
	Для Каждого Имя Из СтрРазделить("РеализацияТоваровУслуг,ВозвратТоваровОтКлиента,ПриходныйКассовыйОрдер,"
		+ "РасходныйКассовыйОрдер,ПоступлениеБезналичныхДенежныхСредств,СписаниеБезналичныхДенежныхСредств,"
		+ "ОперацияПоПлатежнойКарте,ЭквайринговаяОперация,ПриобретениеТоваровУслуг,ЗаказПоставщику,ПеремещениеТоваров,"
		+ "ЗаказПереработчику,ПередачаСырьяПереработчику,ПоступлениеОтПереработчика,"
		+ "ПроизводствоБезЗаказа,ЭтапПроизводства2_2,ЗаказНаПроизводство2_2,ЗаказНаПроизводство,СборкаТоваров,ВыпускПродукции", ",") Цикл
		М = Метаданные.Документы.Найти(Имя);
		Документы_.Добавить(ОписаниеОбъекта(Имя, М));
	КонецЦикла;
	Отчет.Вставить("documents", Документы_);

	// Все регистры накопления, связанные с продажами, деньгами, складом, расчётами
	Регистры = Новый Массив;
	Ключи = СтрРазделить("Выручк,Себестоим,Товар,Склад,Расчет,Денеж,Продаж,Оплат,Переработ,Производ,Выпуск", ",");
	Для Каждого М Из Метаданные.РегистрыНакопления Цикл
		Для Каждого Ключ Из Ключи Цикл
			Если СтрНайти(М.Имя, Ключ) > 0 Тогда
				Регистры.Добавить(ОписаниеОбъекта(М.Имя, М));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Отчет.Вставить("registers", Регистры);

	// Регистры сведений: чеки (Фискальные операции РК — для уведомлений об оплате) и переработка (АВТОКОМП)
	РегистрыСведений_ = Новый Массив;
	Для Каждого М Из Метаданные.РегистрыСведений Цикл
		Если СтрНайти(М.Имя, "Фискальн") > 0 Или СтрНайти(М.Имя, "Переработ") > 0 Тогда
			РегистрыСведений_.Добавить(ОписаниеОбъекта(М.Имя, М));
		КонецЕсли;
	КонецЦикла;
	Отчет.Вставить("info_registers", РегистрыСведений_);

	Справочники_ = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Номенклатура,Партнеры,Контрагенты,Склады,Организации,СтруктураПредприятия,"
		+ "КлючиАналитикиУчетаПоПартнерам,КлючиАналитикиУчетаНоменклатуры,СтатьиДвиженияДенежныхСредств,Кассы", ",") Цикл
		Справочники_.Добавить(ОписаниеОбъекта(Имя, Метаданные.Справочники.Найти(Имя)));
	КонецЦикла;
	Отчет.Вставить("catalogs", Справочники_);

	// Списки организаций и подразделений (для фильтров портала)
	Отчет.Вставить("orgs", СписокНаименований("Справочник.Организации"));
	Отчет.Вставить("departments", СписокНаименований("Справочник.СтруктураПредприятия"));
	Отчет.Вставить("warehouses", СписокНаименований("Справочник.Склады"));

	// Пробный прогон запросов за вчера без отправки — какие падают
	Ошибки = Новый Массив;
	Счетчики = Новый Структура;
	Вчера = НачалоДня(ТекущаяДатаСеанса() - 86400);
	ПопробоватьВид("sales", Вчера, КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("payments", Вчера, КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("cashflow", Вчера, КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("stock", Вчера, КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("debts", Вчера, КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("prod_in", НачалоДня(ТекущаяДатаСеанса() - 30 * 86400), КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("prod_orders", Вчера, КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("prod_raw", Вчера, КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("prod_out", НачалоДня(ТекущаяДатаСеанса() - 30 * 86400), КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("purchases", НачалоДня(ТекущаяДатаСеанса() - 30 * 86400), КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("cost_month", НачалоМесяца(Вчера), КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("partners", Вчера, КонецДня(Вчера), Ошибки, Счетчики);
	ПопробоватьВид("order_clients", НачалоДня(ТекущаяДатаСеанса() - 30 * 86400), КонецДня(Вчера), Ошибки, Счетчики);
	// Закрытие сделок Битрикс24 — пробный прогон: портал только считает, что закрыл бы (23.10.2026)
	Попытка
		ЗакрытьСделкиБ24(Истина, , Счетчики);
	Исключение
		Ошибки.Добавить("deals_close: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Отчет.Вставить("source", Источник());
	Отчет.Вставить("test_counts", Счетчики);
	Отчет.Вставить("test_errors", Ошибки);

	Отправить("meta", Отчет);

КонецПроцедуры

#КонецОбласти

#Область Выгрузка

Процедура Выгрузить(Начало, Конец, СоСнимками)

	Ошибки = Новый Массив;
	Счетчики = Новый Структура;
	Для Каждого Вид Из СтрРазделить("sales,payments,cashflow,prod_in,prod_out,purchases,cost_month,order_clients", ",") Цикл
		Попытка
			НачалоВида = Начало;
			Если Вид = "cost_month" Тогда // месяц целиком: портал заменяет месяц
				НачалоВида = НачалоМесяца(Начало);
			КонецЕсли;
			Если Вид = "order_clients" Тогда // клиенты заказов — всегда вся история: сверка сделок Б24 (проект 19)
				НачалоВида = Мин(Начало, НачалоИстории());
			КонецЕсли;
			Если Вид = "prod_in" Или Вид = "prod_out" Тогда // документов мало — каждый раз 120 дней, история сама подтягивается
				НачалоВида = Мин(Начало, НачалоДня(Конец) - 120 * 86400);
			КонецЕсли;
			Строки = ДанныеВида(Вид, НачалоВида, Конец, Ошибки);
			ОтправитьПорциями(Вид, Строки, НачалоВида, Конец);
			Счетчики.Вставить(Вид, Строки.Количество());
		Исключение
			Ошибки.Добавить(Вид + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Если СоСнимками Тогда
		Для Каждого Вид Из СтрРазделить("stock,debts,prod_orders,prod_raw,partners", ",") Цикл
			Попытка
				Строки = ДанныеВида(Вид, Начало, Конец, Ошибки);
				ОтправитьПорциями(Вид, Строки, Неопределено, Неопределено);
				Счетчики.Вставить(Вид, Строки.Количество());
			Исключение
				Ошибки.Добавить(Вид + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		ВыгрузитьДолгиПоГодам(Ошибки, Счетчики);
	КонецЕсли;

	Итог = Новый Структура("kind,date_from,date_to,counts,errors",
		"run", ДатаJSON(Начало), ДатаJSON(Конец), Счетчики, Ошибки);
	Попытка
		Отправить("meta", Итог);
	Исключение
		// портал недоступен — запишем в журнал ниже
	КонецПопытки;
	Если Ошибки.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации("ANESCOM.Аналитика", УровеньЖурналаРегистрации.Ошибка,,,
			СтрСоединить(Ошибки, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

Процедура ПопробоватьВид(Вид, Начало, Конец, Ошибки, Счетчики)
	Попытка
		Строки = ДанныеВида(Вид, Начало, Конец, Ошибки);
		Счетчики.Вставить(Вид, Строки.Количество());
		Если Строки.Количество() > 0 Тогда
			Счетчики.Вставить(Вид + "_пример", Строки[0]);
		КонецЕсли;
	Исключение
		Ошибки.Добавить(Вид + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Функция ДанныеВида(Вид, Начало, Конец, Ошибки)
	Если Вид = "sales" Тогда
		Возврат Продажи(Начало, Конец, Ошибки);
	ИначеЕсли Вид = "payments" Тогда
		Возврат Поступления(Начало, Конец, Ошибки);
	ИначеЕсли Вид = "cashflow" Тогда
		Возврат ДвижениеДенег(Начало, Конец, Ошибки);
	ИначеЕсли Вид = "stock" Тогда
		Возврат Остатки(Ошибки);
	ИначеЕсли Вид = "debts" Тогда
		Возврат Долги(Ошибки);
	ИначеЕсли Вид = "prod_in" Тогда
		Возврат ПоступленияОтПереработчика(Начало, Конец);
	ИначеЕсли Вид = "prod_orders" Тогда
		Возврат ЗаказыПереработчику();
	ИначеЕсли Вид = "prod_raw" Тогда
		Возврат СырьеУПереработчика();
	ИначеЕсли Вид = "prod_out" Тогда
		Возврат ВыпускПродукции(Начало, Конец);
	ИначеЕсли Вид = "purchases" Тогда
		Возврат Закупки(Начало, Конец, Ошибки);
	ИначеЕсли Вид = "cost_month" Тогда
		Возврат СебестоимостьПоМесяцам(Начало, Конец, Ошибки);
	ИначеЕсли Вид = "partners" Тогда
		Возврат ПартнерыИКонтрагенты(Ошибки);
	ИначеЕсли Вид = "order_clients" Тогда
		Возврат КлиентыЗаказов(Начало, Конец, Ошибки);
	КонецЕсли;
	ВызватьИсключение "Неизвестный вид " + Вид;
КонецФункции

#КонецОбласти

#Область Продажи

// Реализации (+) и возвраты от клиентов (−) по дням, документам и номенклатуре.
Функция Продажи(Начало, Конец, Ошибки)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	Т.Ссылка КАК Документ,
	|	Т.Ссылка.Номер КАК Номер,
	|	Т.Ссылка.Организация КАК Организация,
	|	Т.Ссылка.Подразделение КАК Подразделение,
	|	Т.Ссылка.Склад КАК Склад,
	|	Т.Ссылка.Менеджер КАК Менеджер,
	|	Т.Ссылка.Партнер КАК Партнер,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Номенклатура.Родитель КАК Группа,
	|	СУММА(Т.Количество) КАК Количество,
	|	СУММА(Т.СуммаСНДС) КАК Сумма,
	|	#СКИДКИ#
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|	И Т.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту)
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ), Т.Ссылка, Т.Ссылка.Номер, Т.Ссылка.Организация, Т.Ссылка.Подразделение,
	|	Т.Ссылка.Склад, Т.Ссылка.Менеджер, Т.Ссылка.Партнер, Т.Номенклатура, Т.Номенклатура.Родитель");
	ТекстЗапроса = Запрос.Текст;
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "#СКИДКИ#", ПоляСкидок("РеализацияТоваровУслуг"));
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	Себестоимость = СебестоимостьПродаж(Начало, Конец, Ошибки);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить(СтрокаПродажи(Выборка, 1, Себестоимость));
	КонецЦикла;

	// Возвраты — с минусом. ПРОВЕРИТЬ: реквизиты ВозвратТоваровОтКлиента (Склад, Менеджер, Подразделение).
	Попытка
		// Все возвраты от клиентов (вид операции не фильтруем — в КА 2.4 KZ нет «ВозвратОтКлиента»)
		Запрос.Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(ТекстЗапроса, "#СКИДКИ#", ПоляСкидок("ВозвратТоваровОтКлиента")),
			"Документ.РеализацияТоваровУслуг.Товары", "Документ.ВозвратТоваровОтКлиента.Товары"),
			"Т.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту)",
			"ИСТИНА");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Строки.Добавить(СтрокаПродажи(Выборка, -1, Себестоимость));
		КонецЦикла;
	Исключение
		Ошибки.Добавить("sales/возвраты: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Строки;

КонецФункции

Функция СтрокаПродажи(В, Знак, Себестоимость)
	Ключ = Строка(В.Документ.УникальныйИдентификатор()) + "|" + Строка(В.Номенклатура.УникальныйИдентификатор());
	С = Себестоимость.Получить(Ключ);
	Строка_ = Новый Структура;
	Строка_.Вставить("date", ДатаJSON(В.Дата));
	Строка_.Вставить("doc_key", Строка(В.Документ.УникальныйИдентификатор()));
	Строка_.Вставить("doc_no", СокрЛП(В.Номер));
	Строка_.Вставить("org", Строка(В.Организация));
	Строка_.Вставить("branch", Строка(В.Подразделение));
	Строка_.Вставить("warehouse", Строка(В.Склад));
	Строка_.Вставить("manager", Строка(В.Менеджер));
	Строка_.Вставить("client", Строка(В.Партнер));
	Строка_.Вставить("client_key", Ид(В.Партнер));
	Строка_.Вставить("item", Строка(В.Номенклатура));
	Строка_.Вставить("item_key", Ид(В.Номенклатура));
	Строка_.Вставить("item_group", Строка(В.Группа));
	Строка_.Вставить("qty", Знак * В.Количество);
	Строка_.Вставить("sum", Знак * В.Сумма);
	Строка_.Вставить("cost", ?(С = Неопределено, 0, С)); // знак уже в регистре
	Строка_.Вставить("disc_auto", Знак * В.СкидкаАвто);
	Строка_.Вставить("disc_manual", Знак * В.СкидкаРучная);
	Строка_.Вставить("vat", Знак * В.НДС);
	Возврат Строка_;
КонецФункции

// Поля скидок и НДС табличной части «Товары» (22.10.2026): берём только те, что есть в конфигурации.
Функция ПоляСкидок(ИмяДокумента)
	ТЧ = Метаданные.Документы[ИмяДокумента].ТабличныеЧасти.Товары;
	Поле = ПолеИлиНоль(ТЧ, "СуммаАвтоматическойСкидки") + " КАК СкидкаАвто,
	|	" + ПолеИлиНоль(ТЧ, "СуммаРучнойСкидки") + " КАК СкидкаРучная,
	|	" + ПолеИлиНоль(ТЧ, "СуммаНДС") + " КАК НДС";
	Возврат Поле;
КонецФункции

// Доп. расходы (доставка, пошлина) — отдельный ресурс регистров себестоимости; без него себестоимость занижена
// (проверено 22.10.2026 на GEZE: 12,47 млн вместо 15,42 млн по отчёту 1С). Возвращает " + СУММА(Т.ДопРасходыОборот)" или "".
Функция ПолеДопРасходов(ИмяРегистра, Псевдоним, Суффикс)
	Рег = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если Рег = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("ДопРасходы,СтоимостьДопРасходы,ДопРасходыРегл", ",") Цикл
		Если Рег.Ресурсы.Найти(Имя) <> Неопределено Тогда
			Возврат " + СУММА(" + Псевдоним + "." + Имя + Суффикс + ")";
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ПолеИлиНоль(ТЧ, Имя)
	Возврат ?(ТЧ.Реквизиты.Найти(Имя) = Неопределено, "0", "СУММА(Т." + Имя + ")");
КонецФункции

// Себестоимость по документу и номенклатуре из регистра ВыручкаИСебестоимостьПродаж.
// ⚠ Себестоимость текущего месяца в КА появляется после «Закрытия месяца» — до этого 0, портал покажет «оценку».
// ПРОВЕРИТЬ: имя ресурса (Стоимость / СтоимостьРегл) и измерения АналитикаУчетаНоменклатуры.
Функция СебестоимостьПродаж(Начало, Конец, Ошибки)
	Соответствие_ = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ВС.Регистратор КАК Документ,
		|	ВС.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	СУММА(ВС.СтоимостьОборот)#ДОП# КАК Стоимость
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&Начало, &Конец, Регистратор) КАК ВС
		|СГРУППИРОВАТЬ ПО
		|	ВС.Регистратор, ВС.АналитикаУчетаНоменклатуры.Номенклатура");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ДОП#", ПолеДопРасходов("ВыручкаИСебестоимостьПродаж", "ВС", "Оборот"));
		Запрос.УстановитьПараметр("Начало", Начало);
		Запрос.УстановитьПараметр("Конец", Конец);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Документ) Тогда
				Продолжить;
			КонецЕсли;
			Ключ = Строка(Выборка.Документ.УникальныйИдентификатор()) + "|" + Ид(Выборка.Номенклатура);
			Соответствие_.Вставить(Ключ, Выборка.Стоимость);
		КонецЦикла;
	Исключение
		Ошибки.Добавить("sales/себестоимость: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Соответствие_;
КонецФункции

#КонецОбласти

#Область ЗакупкиИСебестоимость

// Закупки у поставщиков (22.10.2026): «Приобретение товаров и услуг», сумма без НДС в тенге
// (валютные документы — по курсу на дату документа). Нужна для отчёта «Товары и группы» (отбор по поставщику,
// цена поставщика). Доп. расходы (доставка, пошлина) — в виде cost_month.
Функция Закупки(Начало, Конец, Ошибки)
	Строки = Новый Массив;
	ТЧ = Метаданные.Документы.ПриобретениеТоваровУслуг.ТабличныеЧасти.Товары;
	ПолеНДС = ?(ТЧ.Реквизиты.Найти("СуммаНДС") = Неопределено, "0", "СУММА(Т.СуммаНДС)");
	ПолеСуммы = ?(ТЧ.Реквизиты.Найти("СуммаСНДС") = Неопределено, "СУММА(Т.Сумма)", "СУММА(Т.СуммаСНДС)");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	Т.Ссылка КАК Документ,
	|	Т.Ссылка.Номер КАК Номер,
	|	Т.Ссылка.Организация КАК Организация,
	|	Т.Ссылка.Партнер КАК Поставщик,
	|	Т.Ссылка.Склад КАК Склад,
	|	Т.Ссылка.Валюта КАК Валюта,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Номенклатура.Родитель КАК Группа,
	|	СУММА(Т.Количество) КАК Количество,
	|	" + ПолеСуммы + " КАК СуммаСНДС,
	|	" + ПолеНДС + " КАК НДС
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ), Т.Ссылка, Т.Ссылка.Номер, Т.Ссылка.Организация, Т.Ссылка.Партнер,
	|	Т.Ссылка.Склад, Т.Ссылка.Валюта, Т.Номенклатура, Т.Номенклатура.Родитель");
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	ВалютаРегл = Неопределено;
	Попытка
		ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
	Исключение
	КонецПопытки;
	Курсы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Без = Выборка.СуммаСНДС - Выборка.НДС;
		Курс = 1;
		Если ЗначениеЗаполнено(Выборка.Валюта) И Выборка.Валюта <> ВалютаРегл Тогда
			Ключ = Ид(Выборка.Валюта) + Формат(Выборка.Дата, "ДФ=yyyyMMdd");
			Курс = Курсы.Получить(Ключ);
			Если Курс = Неопределено Тогда
				Курс = КурсВалюты(Выборка.Валюта, Выборка.Дата, Ошибки);
				Курсы.Вставить(Ключ, Курс);
			КонецЕсли;
		КонецЕсли;
		С = Новый Структура;
		С.Вставить("date", ДатаJSON(Выборка.Дата));
		С.Вставить("doc_key", Ид(Выборка.Документ));
		С.Вставить("doc_no", СокрЛП(Выборка.Номер));
		С.Вставить("org", Строка(Выборка.Организация));
		С.Вставить("supplier", Строка(Выборка.Поставщик));
		С.Вставить("supplier_key", Ид(Выборка.Поставщик));
		С.Вставить("warehouse", Строка(Выборка.Склад));
		С.Вставить("item", Строка(Выборка.Номенклатура));
		С.Вставить("item_key", Ид(Выборка.Номенклатура));
		С.Вставить("item_group", Строка(Выборка.Группа));
		С.Вставить("qty", Выборка.Количество);
		С.Вставить("currency", Строка(Выборка.Валюта));
		С.Вставить("sum_cur", Без);
		С.Вставить("sum", Окр(Без * Курс, 2));
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

Функция КурсВалюты(Валюта, Дата, Ошибки)
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ К.Курс КАК Курс, К.Кратность КАК Кратность
		|ИЗ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК К");
		Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
		Запрос.УстановитьПараметр("Валюта", Валюта);
		В = Запрос.Выполнить().Выбрать();
		Если В.Следующий() И В.Кратность > 0 Тогда
			Возврат В.Курс / В.Кратность;
		КонецЕсли;
	Исключение
		Ошибки.Добавить("purchases/курс: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат 1;
КонецФункции

// Себестоимость по месяцам (как отчёт 1С «Себестоимость товаров организаций»): по организации и номенклатуре —
// остаток на начало, приход (стоимость поступления и доп. расходы: доставка, пошлина), расход, остаток на конец.
// date = первое число месяца. Ресурс доп. расходов ищется по метаданным (ДопРасходы / СтоимостьДопРасходы).
Функция СебестоимостьПоМесяцам(Начало, Конец, Ошибки)
	Строки = Новый Массив;
	Рег = Метаданные.РегистрыНакопления.СебестоимостьТоваров;
	Доп = "";
	Для Каждого Имя Из СтрРазделить("ДопРасходы,СтоимостьДопРасходы,ДопРасходыРегл", ",") Цикл
		Если Рег.Ресурсы.Найти(Имя) <> Неопределено Тогда
			Доп = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Доп = "" Тогда
		Ошибки.Добавить("cost_month: в СебестоимостьТоваров нет ресурса доп. расходов — доп. расходы = 0");
	КонецЕсли;
	ПолеДоп = ?(Доп = "", "0", "СУММА(С." + Доп + "Приход)");
	ПолеДопН = ?(Доп = "", "0", "СУММА(С." + Доп + "НачальныйОстаток)");
	ПолеДопК = ?(Доп = "", "0", "СУММА(С." + Доп + "КонечныйОстаток)");
	ПолеДопР = ?(Доп = "", "0", "СУММА(С." + Доп + "Расход)");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	С.Период КАК Месяц,
	|	С.Организация КАК Организация,
	|	С.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	С.АналитикаУчетаНоменклатуры.Номенклатура.Родитель КАК Группа,
	|	СУММА(С.КоличествоНачальныйОстаток) КАК КолН,
	|	СУММА(С.СтоимостьНачальныйОстаток) + " + ПолеДопН + " КАК СтН,
	|	СУММА(С.КоличествоПриход) КАК КолП,
	|	СУММА(С.СтоимостьПриход) КАК СтП,
	|	" + ПолеДоп + " КАК ДопП,
	|	СУММА(С.КоличествоРасход) КАК КолР,
	|	СУММА(С.СтоимостьРасход) + " + ПолеДопР + " КАК СтР,
	|	СУММА(С.КоличествоКонечныйОстаток) КАК КолК,
	|	СУММА(С.СтоимостьКонечныйОстаток) + " + ПолеДопК + " КАК СтК
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.ОстаткиИОбороты(&Начало, &Конец, Месяц, Движения, ) КАК С
	|СГРУППИРОВАТЬ ПО
	|	С.Период, С.Организация, С.АналитикаУчетаНоменклатуры.Номенклатура,
	|	С.АналитикаУчетаНоменклатуры.Номенклатура.Родитель");
	Запрос.УстановитьПараметр("Начало", НачалоМесяца(Начало));
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.КолН = 0 И Выборка.КолП = 0 И Выборка.КолР = 0 И Выборка.КолК = 0 Тогда
			Продолжить;
		КонецЕсли;
		С = Новый Структура;
		С.Вставить("date", ДатаJSON(НачалоМесяца(Выборка.Месяц)));
		С.Вставить("org", Строка(Выборка.Организация));
		С.Вставить("item", Строка(Выборка.Номенклатура));
		С.Вставить("item_key", Ид(Выборка.Номенклатура));
		С.Вставить("item_group", Строка(Выборка.Группа));
		С.Вставить("qty_beg", Выборка.КолН);
		С.Вставить("cost_beg", Выборка.СтН);
		С.Вставить("qty_in", Выборка.КолП);
		С.Вставить("cost_in", Выборка.СтП);
		С.Вставить("extra_in", Выборка.ДопП);
		С.Вставить("qty_out", Выборка.КолР);
		С.Вставить("cost_out", Выборка.СтР);
		С.Вставить("qty_end", Выборка.КолК);
		С.Вставить("cost_end", Выборка.СтК);
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

#КонецОбласти

#Область Деньги

// Поступления от клиентов. Вид: ПКО → cash, операция по платёжной карте → card, безнал → bank.
Функция Поступления(Начало, Конец, Ошибки)
	Строки = Новый Массив;
	Источники = Новый Соответствие;
	Источники.Вставить("ПриходныйКассовыйОрдер", "cash");
	Источники.Вставить("ОперацияПоПлатежнойКарте", "card");
	Источники.Вставить("ПоступлениеБезналичныхДенежныхСредств", "bank");
	Филиалы = Неопределено; // филиал клиента — если в документе оплаты подразделение пустое
	Для Каждого Ист Из Источники Цикл
		Попытка
			Запрос = Новый Запрос(СтрЗаменить(
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
			|	Т.Ссылка КАК Документ,
			|	Т.Ссылка.Номер КАК Номер,
			|	Т.Ссылка.Организация КАК Организация,
			|	Т.Ссылка.Подразделение КАК Подразделение,
			|	Т.Партнер КАК Партнер,
			|	Т.Партнер.ОсновнойМенеджер КАК Менеджер,
			|	СУММА(Т.Сумма) КАК Сумма
			|ИЗ
			|	Документ.#ИМЯ#.РасшифровкаПлатежа КАК Т
			|ГДЕ
			|	Т.Ссылка.Проведен
			|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
			|	И Т.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента)
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ), Т.Ссылка, Т.Ссылка.Номер, Т.Ссылка.Организация,
			|	Т.Ссылка.Подразделение, Т.Партнер, Т.Партнер.ОсновнойМенеджер", "#ИМЯ#", Ист.Ключ));
			Запрос.УстановитьПараметр("Начало", Начало);
			Запрос.УстановитьПараметр("Конец", Конец);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				С = Новый Структура;
				С.Вставить("date", ДатаJSON(Выборка.Дата));
				С.Вставить("doc_key", Ид(Выборка.Документ));
				С.Вставить("doc_no", СокрЛП(Выборка.Номер));
				С.Вставить("org", Строка(Выборка.Организация));
				Филиал = Строка(Выборка.Подразделение);
				Если Не ЗначениеЗаполнено(Выборка.Подразделение) Тогда
					Если Филиалы = Неопределено Тогда
						Филиалы = ФилиалыКлиентов(Ошибки);
					КонецЕсли;
					Филиал = Филиалы.Получить("П" + Ид(Выборка.Партнер));
					Филиал = ?(Филиал = Неопределено, "", Филиал);
				КонецЕсли;
				С.Вставить("branch", Филиал);
				С.Вставить("manager", Строка(Выборка.Менеджер));
				С.Вставить("client", Строка(Выборка.Партнер));
				С.Вставить("client_key", Ид(Выборка.Партнер));
				С.Вставить("kind", Ист.Значение);
				С.Вставить("sum", Выборка.Сумма);
				Строки.Добавить(С);
			КонецЦикла;
		Исключение
			Ошибки.Добавить("payments/" + Ист.Ключ + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Движение денег по статьям ДДС: приход (ПКО, безнал, карта) и расход (РКО, списание безнала).
// ПРОВЕРИТЬ: СтатьяДвиженияДенежныхСредств в ТЧ РасшифровкаПлатежа; Контрагент в шапке.
Функция ДвижениеДенег(Начало, Конец, Ошибки)
	Строки = Новый Массив;
	Источники = Новый Соответствие;
	Источники.Вставить("ПриходныйКассовыйОрдер", "in");
	Источники.Вставить("ОперацияПоПлатежнойКарте", "in");
	Источники.Вставить("ПоступлениеБезналичныхДенежныхСредств", "in");
	Источники.Вставить("РасходныйКассовыйОрдер", "out");
	Источники.Вставить("СписаниеБезналичныхДенежныхСредств", "out");
	Для Каждого Ист Из Источники Цикл
		Попытка
			Запрос = Новый Запрос(СтрЗаменить(
			"ВЫБРАТЬ
			|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
			|	Т.Ссылка КАК Документ,
			|	Т.Ссылка.Номер КАК Номер,
			|	Т.Ссылка.Организация КАК Организация,
			|	Т.Ссылка.Подразделение КАК Подразделение,
			|	Т.Ссылка.Контрагент КАК Контрагент,
			|	Т.СтатьяДвиженияДенежныхСредств КАК Статья,
			|	СУММА(Т.Сумма) КАК Сумма
			|ИЗ
			|	Документ.#ИМЯ#.РасшифровкаПлатежа КАК Т
			|ГДЕ
			|	Т.Ссылка.Проведен
			|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ), Т.Ссылка, Т.Ссылка.Номер, Т.Ссылка.Организация,
			|	Т.Ссылка.Подразделение, Т.Ссылка.Контрагент, Т.СтатьяДвиженияДенежныхСредств", "#ИМЯ#", Ист.Ключ));
			Запрос.УстановитьПараметр("Начало", Начало);
			Запрос.УстановитьПараметр("Конец", Конец);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				С = Новый Структура;
				С.Вставить("date", ДатаJSON(Выборка.Дата));
				С.Вставить("doc_key", Ид(Выборка.Документ));
				С.Вставить("doc_no", СокрЛП(Выборка.Номер));
				С.Вставить("org", Строка(Выборка.Организация));
				С.Вставить("branch", Строка(Выборка.Подразделение));
				С.Вставить("article", Строка(Выборка.Статья));
				С.Вставить("counterparty", Строка(Выборка.Контрагент));
				С.Вставить("direction", Ист.Значение);
				С.Вставить("sum", Выборка.Сумма);
				Строки.Добавить(С);
			КонецЦикла;
		Исключение
			Ошибки.Добавить("cashflow/" + Ист.Ключ + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Строки;
КонецФункции

#КонецОбласти

#Область СкладИРасчеты

// Остатки по складам + последняя продажа и продажи за 30/90 дней (портал считает дозаказ и неликвид).
// ПРОВЕРИТЬ: ресурс ВНаличии у регистра ТоварыНаСкладах; Склад.Подразделение.
Функция Остатки(Ошибки)
	Сейчас = ТекущаяДатаСеанса();
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Склад КАК Склад,
	|	СУММА(ВЫБОР КОГДА Т.Ссылка.Дата >= &Дней30 ТОГДА Т.Количество ИНАЧЕ 0 КОНЕЦ) КАК Продано30,
	|	СУММА(ВЫБОР КОГДА Т.Ссылка.Дата >= &Дней90 ТОГДА Т.Количество ИНАЧЕ 0 КОНЕЦ) КАК Продано90,
	|	МАКСИМУМ(Т.Ссылка.Дата) КАК Последняя
	|ПОМЕСТИТЬ Продажи
	|ИЗ
	|	(ВЫБРАТЬ Т.Номенклатура КАК Номенклатура, Т.Ссылка.Склад КАК Склад, Т.Ссылка КАК Ссылка, Т.Количество КАК Количество
	|	ИЗ Документ.РеализацияТоваровУслуг.Товары КАК Т
	|	ГДЕ Т.Ссылка.Проведен И Т.Ссылка.Дата >= &Год) КАК Т
	|СГРУППИРОВАТЬ ПО
	|	Т.Номенклатура, Т.Склад
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура, Склад
	|;
	|ВЫБРАТЬ
	|	О.Номенклатура КАК Номенклатура,
	|	О.Номенклатура.Родитель КАК Группа,
	|	О.Номенклатура.ЕдиницаИзмерения КАК Единица,
	|	О.Склад КАК Склад,
	|	О.Склад.Подразделение КАК Подразделение,
	|	СУММА(О.ВНаличииОстаток) КАК Количество,
	|	ЕСТЬNULL(МАКСИМУМ(П.Продано30), 0) КАК Продано30,
	|	ЕСТЬNULL(МАКСИМУМ(П.Продано90), 0) КАК Продано90,
	|	МАКСИМУМ(П.Последняя) КАК Последняя
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК О
	|		ЛЕВОЕ СОЕДИНЕНИЕ Продажи КАК П
	|		ПО О.Номенклатура = П.Номенклатура И О.Склад = П.Склад
	|СГРУППИРОВАТЬ ПО
	|	О.Номенклатура, О.Номенклатура.Родитель, О.Номенклатура.ЕдиницаИзмерения, О.Склад, О.Склад.Подразделение
	|ИМЕЮЩИЕ
	|	СУММА(О.ВНаличииОстаток) <> 0");
	Запрос.УстановитьПараметр("Дней30", Сейчас - 30 * 86400);
	Запрос.УстановитьПараметр("Дней90", Сейчас - 90 * 86400);
	Запрос.УстановитьПараметр("Год", ДобавитьМесяц(Сейчас, -24));

	Цены = СебестоимостьЕдиницы(Ошибки);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цена = Цены.Получить(Ид(Выборка.Номенклатура));
		С = Новый Структура;
		С.Вставить("org", "");
		С.Вставить("branch", Строка(Выборка.Подразделение));
		С.Вставить("warehouse", Строка(Выборка.Склад));
		С.Вставить("item", Строка(Выборка.Номенклатура));
		С.Вставить("item_key", Ид(Выборка.Номенклатура));
		С.Вставить("item_group", Строка(Выборка.Группа));
		С.Вставить("unit", Строка(Выборка.Единица));
		С.Вставить("qty", Выборка.Количество);
		// Себестоимость: средняя цена единицы (СебестоимостьТоваров, иначе себестоимость продаж за год) × остаток.
		С.Вставить("cost_sum", ?(Цена = Неопределено Или Выборка.Количество <= 0, 0, Окр(Цена * Выборка.Количество, 2)));
		С.Вставить("last_sale", ?(ЗначениеЗаполнено(Выборка.Последняя), ДатаJSON(Выборка.Последняя), ""));
		С.Вставить("sold_30", Выборка.Продано30);
		С.Вставить("sold_90", Выборка.Продано90);
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Долги и переплаты клиентов — как в документе «Сверка взаиморасчетов» (решение пользователя 18.10 12:40):
// регистр РасчетыСКлиентамиПоДокументам, суммы регламентированного учёта (ДолгРегл / ПредоплатаРегл),
// в разрезе организации и контрагента (каждая организация отдельно). Сальдо: долг + предоплата (предоплата в регистре отрицательная).
// НаДату — остатки на конец этого дня (для debts_hist: 31.12 закрытых лет, 6м 19.10.2026); без даты — текущие.
Функция Долги(Ошибки, НаДату = Неопределено)
	ТекстОстатков = ?(НаДату = Неопределено, "РегистрНакопления.РасчетыСКлиентамиПоДокументам.Остатки",
		"РегистрНакопления.РасчетыСКлиентамиПоДокументам.Остатки(&Граница)");
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Р.АналитикаУчетаПоПартнерам.Организация КАК Организация,
	|	Р.АналитикаУчетаПоПартнерам.Контрагент КАК Контрагент,
	|	МАКСИМУМ(Р.АналитикаУчетаПоПартнерам.Партнер.ОсновнойМенеджер) КАК Менеджер,
	|	СУММА(Р.ДолгРеглОстаток) КАК Долг,
	|	СУММА(Р.ПредоплатаРеглОстаток) КАК Предоплата
	|ИЗ
	|	" + ТекстОстатков + " КАК Р
	|СГРУППИРОВАТЬ ПО
	|	Р.АналитикаУчетаПоПартнерам.Организация, Р.АналитикаУчетаПоПартнерам.Контрагент
	|ИМЕЮЩИЕ
	|	СУММА(Р.ДолгРеглОстаток) + СУММА(Р.ПредоплатаРеглОстаток) <> 0");
	Если НаДату <> Неопределено Тогда
		Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(НаДату), ВидГраницы.Включая));
	КонецЕсли;
	Филиалы = ФилиалыКлиентов(Ошибки);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Предоплата в регистре — расход (отрицательный остаток): аванс клиента = Долг + Предоплата < 0.
		// (18.10.2026: «ДиАман ТОО» — оплата 87,9 млн без реализаций показывалась долгом.)
		Сальдо = Выборка.Долг + Выборка.Предоплата;
		С = Новый Структура;
		С.Вставить("org", Строка(Выборка.Организация));
		Филиал = Филиалы.Получить("К" + Ид(Выборка.Контрагент));
		С.Вставить("branch", ?(Филиал = Неопределено, "", Филиал));
		С.Вставить("manager", Строка(Выборка.Менеджер));
		С.Вставить("client", Строка(Выборка.Контрагент));
		С.Вставить("client_key", Ид(Выборка.Контрагент));
		С.Вставить("debt", Макс(Сальдо, 0));
		С.Вставить("prepay", Макс(-Сальдо, 0));
		С.Вставить("overdue", 0);
		С.Вставить("overdue_days", 0);
		Если НаДату <> Неопределено Тогда
			С.Вставить("date", ДатаJSON(НаДату));
			С.Вставить("year", Формат(Год(НаДату), "ЧГ=0"));
		КонецЕсли;
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Долги и переплаты на 31.12 каждого закрытого года с начала истории (вид debts_hist; портал заменяет год целиком).
// Для кнопок прошлых лет на портале: «долги на 31.12.2025» и т.д. (6м, 19.10.2026).
Процедура ВыгрузитьДолгиПоГодам(Ошибки, Счетчики)
	Всего = 0;
	Для Г = Год(НачалоИстории()) По Год(ТекущаяДатаСеанса()) - 1 Цикл
		Попытка
			НаДату = Дата(Г, 12, 31);
			Строки = Долги(Ошибки, НаДату);
			ОтправитьПорциями("debts_hist", Строки, НаДату, НаДату);
			Всего = Всего + Строки.Количество();
		Исключение
			Ошибки.Добавить("debts_hist " + Формат(Г, "ЧГ=0") + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Счетчики.Вставить("debts_hist", Всего);
КонецПроцедуры

// Себестоимость единицы по номенклатуре (ключ — Ид). 18.10.2026 16:30.
// 1) остатки регистра СебестоимостьТоваров: Стоимость / Количество (только если оба > 0);
// 2) для остальных — себестоимость продаж за 365 дней (ВыручкаИСебестоимостьПродаж).
// ПРОВЕРИТЬ в копии: ресурсы Количество/Стоимость, измерение АналитикаУчетаНоменклатуры.
// Портал дополнительно отбрасывает неправдоподобные значения (> 5 × цена продажи).
Функция СебестоимостьЕдиницы(Ошибки)
	Цены = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	О.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	СУММА(О.КоличествоОстаток) КАК Количество,
		|	СУММА(О.СтоимостьОстаток)#ДОП# КАК Стоимость
		|ИЗ
		|	РегистрНакопления.СебестоимостьТоваров.Остатки КАК О
		|СГРУППИРОВАТЬ ПО
		|	О.АналитикаУчетаНоменклатуры.Номенклатура");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ДОП#", ПолеДопРасходов("СебестоимостьТоваров", "О", "Остаток"));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Количество > 0 И Выборка.Стоимость > 0 Тогда
				Цены.Вставить(Ид(Выборка.Номенклатура), Выборка.Стоимость / Выборка.Количество);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("stock/себестоимость остатков: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ВС.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	СУММА(ВС.КоличествоОборот) КАК Количество,
		|	СУММА(ВС.СтоимостьОборот)#ДОП# КАК Стоимость
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&Начало, , ) КАК ВС
		|СГРУППИРОВАТЬ ПО
		|	ВС.АналитикаУчетаНоменклатуры.Номенклатура");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ДОП#", ПолеДопРасходов("ВыручкаИСебестоимостьПродаж", "ВС", "Оборот"));
		Запрос.УстановитьПараметр("Начало", ТекущаяДатаСеанса() - 365 * 86400);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = Ид(Выборка.Номенклатура);
			Если Цены.Получить(Ключ) = Неопределено И Выборка.Количество > 0 И Выборка.Стоимость > 0 Тогда
				Цены.Вставить(Ключ, Выборка.Стоимость / Выборка.Количество);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("stock/себестоимость продаж: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Цены;
КонецФункции

// Филиал клиента = подразделение, где у клиента больше всего реализаций за 2 года (как на портале).
// Ключи: "К" + Ид(Контрагент) — для долгов, "П" + Ид(Партнер) — для оплат без подразделения. 18.10.2026 16:30.
Функция ФилиалыКлиентов(Ошибки)
	Лучшие = Новый Соответствие; // ключ → Структура(Филиал, Сумма)
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Р.Контрагент КАК Контрагент,
		|	Р.Партнер КАК Партнер,
		|	Р.Подразделение КАК Подразделение,
		|	СУММА(Р.СуммаДокумента) КАК Сумма
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Р
		|ГДЕ
		|	Р.Проведен
		|	И Р.Дата >= &Начало
		|СГРУППИРОВАТЬ ПО
		|	Р.Контрагент, Р.Партнер, Р.Подразделение");
		Запрос.УстановитьПараметр("Начало", ДобавитьМесяц(ТекущаяДатаСеанса(), -24));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Подразделение) Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Ключ Из СтрРазделить("К" + Ид(Выборка.Контрагент) + ";П" + Ид(Выборка.Партнер), ";") Цикл
				Было = Лучшие.Получить(Ключ);
				Если Было = Неопределено Или Выборка.Сумма > Было.Сумма Тогда
					Лучшие.Вставить(Ключ, Новый Структура("Филиал,Сумма", Строка(Выборка.Подразделение), Выборка.Сумма));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("филиалы клиентов: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Филиалы = Новый Соответствие;
	Для Каждого КЗ Из Лучшие Цикл
		Филиалы.Вставить(КЗ.Ключ, КЗ.Значение.Филиал);
	КонецЦикла;
	Возврат Филиалы;
КонецФункции

#КонецОбласти

#Область КлиентыИПоставщики

// Проект 19 (23.10.2026): справочник клиентов/поставщиков для сверки с Bitrix24 (1С — главная).
// Снимок partners — по строке на каждого партнёра, контрагента и контактное лицо партнёра:
//   rec (partner | contr | person), key (GUID), name, full_name, partner_key (для contr/person — владелец),
//   inn (БИН/ИИН контрагента), legal (ЮрФизЛицо), region (бизнес-регион партнёра), manager, phones, emails (через «; »),
//   flag_client / flag_supplier (отметки партнёра 1С), sold / bought (были наши реализации / его поступления к нам),
//   last_sale (дата последней реализации), deleted (пометка удаления).
Функция ПартнерыИКонтрагенты(Ошибки)
	Строки = Новый Массив;
	Продажи_ = ДатыДокументовПоПартнерам("РеализацияТоваровУслуг", Ошибки);
	Закупки_ = ДатыДокументовПоПартнерам("ПриобретениеТоваровУслуг", Ошибки);
	Телефоны = КонтактыВладельцев("Партнеры", Ошибки);
	ТелефоныК = КонтактыВладельцев("Контрагенты", Ошибки);

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Наименование КАК Наименование,
	|	П.НаименованиеПолное КАК НаименованиеПолное,
	|	П.ЮрФизЛицо КАК ЮрФизЛицо,
	|	П.БизнесРегион КАК БизнесРегион,
	|	П.ОсновнойМенеджер КАК Менеджер,
	|	П.Клиент КАК Клиент,
	|	П.Поставщик КАК Поставщик,
	|	П.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.Партнеры КАК П
	|ГДЕ
	|	#НЕГРУППА#");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#НЕГРУППА#",
		?(Метаданные.Справочники.Партнеры.Иерархический, "НЕ П.ЭтоГруппа", "ИСТИНА"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = Ид(Выборка.Ссылка);
		С = СтрокаКлиента("partner", Ключ, Выборка.Наименование, Ключ);
		С.Вставить("full_name", СокрЛП(Выборка.НаименованиеПолное));
		С.Вставить("legal", Строка(Выборка.ЮрФизЛицо));
		С.Вставить("region", Строка(Выборка.БизнесРегион));
		С.Вставить("manager", Строка(Выборка.Менеджер));
		ЗаполнитьКонтакты(С, Телефоны.Получить(Ключ));
		С.Вставить("flag_client", ?(Выборка.Клиент, "1", ""));
		С.Вставить("flag_supplier", ?(Выборка.Поставщик, "1", ""));
		ДатаПродажи = Продажи_.Получить(Ключ);
		С.Вставить("sold", ?(ДатаПродажи = Неопределено, "", "1"));
		С.Вставить("last_sale", ?(ДатаПродажи = Неопределено, "", ДатаJSON(ДатаПродажи)));
		С.Вставить("bought", ?(Закупки_.Получить(Ключ) = Неопределено, "", "1"));
		С.Вставить("deleted", ?(Выборка.ПометкаУдаления, "1", ""));
		Строки.Добавить(С);
	КонецЦикла;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка,
	|	К.Наименование КАК Наименование,
	|	К.НаименованиеПолное КАК НаименованиеПолное,
	|	К.Партнер КАК Партнер,
	|	К.ИНН КАК ИНН,
	|	К.ЮрФизЛицо КАК ЮрФизЛицо,
	|	К.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	#НЕГРУППА#");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#НЕГРУППА#",
		?(Метаданные.Справочники.Контрагенты.Иерархический, "НЕ К.ЭтоГруппа", "ИСТИНА"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = Ид(Выборка.Ссылка);
		С = СтрокаКлиента("contr", Ключ, Выборка.Наименование, Ид(Выборка.Партнер));
		С.Вставить("full_name", СокрЛП(Выборка.НаименованиеПолное));
		С.Вставить("inn", СокрЛП(Выборка.ИНН));
		С.Вставить("legal", Строка(Выборка.ЮрФизЛицо));
		ЗаполнитьКонтакты(С, ТелефоныК.Получить(Ключ));
		С.Вставить("deleted", ?(Выборка.ПометкаУдаления, "1", ""));
		Строки.Добавить(С);
	КонецЦикла;

	// Контактные лица партнёров — коннектор Б24 может заводить их контактами
	Если Метаданные.Справочники.Найти("КонтактныеЛицаПартнеров") <> Неопределено Тогда
		Попытка
			ТелефоныЛ = КонтактыВладельцев("КонтактныеЛицаПартнеров", Ошибки);
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Л.Ссылка КАК Ссылка,
			|	Л.Наименование КАК Наименование,
			|	Л.Владелец КАК Владелец,
			|	Л.ПометкаУдаления КАК ПометкаУдаления
			|ИЗ
			|	Справочник.КонтактныеЛицаПартнеров КАК Л");
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Ключ = Ид(Выборка.Ссылка);
				С = СтрокаКлиента("person", Ключ, Выборка.Наименование, Ид(Выборка.Владелец));
				ЗаполнитьКонтакты(С, ТелефоныЛ.Получить(Ключ));
				С.Вставить("deleted", ?(Выборка.ПометкаУдаления, "1", ""));
				Строки.Добавить(С);
			КонецЦикла;
		Исключение
			Ошибки.Добавить("partners/контактные лица: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	Возврат Строки;
КонецФункции

Функция СтрокаКлиента(Вид, Ключ, Наименование, КлючПартнера)
	С = Новый Структура;
	Для Каждого Имя Из СтрРазделить("rec,key,name,full_name,partner_key,inn,legal,region,manager,phones,emails,"
		+ "flag_client,flag_supplier,sold,bought,last_sale,deleted", ",") Цикл
		С.Вставить(Имя, "");
	КонецЦикла;
	С.rec = Вид;
	С.key = Ключ;
	С.name = СокрЛП(Наименование);
	С.partner_key = КлючПартнера;
	Возврат С;
КонецФункции

Процедура ЗаполнитьКонтакты(С, Контакты)
	Если Контакты <> Неопределено Тогда
		С.phones = СтрСоединить(Контакты.Телефоны, "; ");
		С.emails = СтрСоединить(Контакты.Почта, "; ");
	КонецЕсли;
КонецПроцедуры

// Телефоны и e-mail из ТЧ КонтактнаяИнформация справочника: Ид владельца → Структура(Телефоны, Почта) — массивы без повторов.
Функция КонтактыВладельцев(ИмяСправочника, Ошибки)
	Итог = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КИ.Ссылка КАК Владелец,
		|	КИ.Тип КАК Тип,
		|	КИ.Представление КАК Представление
		|ИЗ
		|	Справочник." + ИмяСправочника + ".КонтактнаяИнформация КАК КИ
		|ГДЕ
		|	КИ.Тип В (ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон),
		|		ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = Ид(Выборка.Владелец);
			К = Итог.Получить(Ключ);
			Если К = Неопределено Тогда
				К = Новый Структура("Телефоны,Почта", Новый Массив, Новый Массив);
				Итог.Вставить(Ключ, К);
			КонецЕсли;
			Значение = СокрЛП(Выборка.Представление);
			Список = ?(Выборка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон, К.Телефоны, К.Почта);
			Если ЗначениеЗаполнено(Значение) И Список.Найти(Значение) = Неопределено Тогда
				Список.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Ошибки.Добавить("partners/контакты " + ИмяСправочника + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Итог;
КонецФункции

// Ид партнёра → дата последнего проведённого документа (реализации или поступления) за всё время.
Функция ДатыДокументовПоПартнерам(ИмяДокумента, Ошибки)
	Итог = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Д.Партнер КАК Партнер,
		|	МАКСИМУМ(Д.Дата) КАК Дата
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Д
		|ГДЕ
		|	Д.Проведен
		|СГРУППИРОВАТЬ ПО
		|	Д.Партнер");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Итог.Вставить(Ид(Выборка.Партнер), Выборка.Дата);
		КонецЦикла;
	Исключение
		Ошибки.Добавить("partners/" + ИмяДокумента + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Итог;
КонецФункции

// Вид order_clients (за период): клиент каждого заказа — чтобы найти сделки Б24, привязанные не к тому клиенту.
//   date, order_key (= ORIGIN_ID сделки), order_no, org, partner_key, contr_key, person_key (контактное лицо, если есть), sum
Функция КлиентыЗаказов(Начало, Конец, Ошибки)
	ЕстьКонтактноеЛицо = Метаданные.Документы.ЗаказКлиента.Реквизиты.Найти("КонтактноеЛицо") <> Неопределено;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	З.Ссылка КАК Ссылка,
	|	З.Дата КАК Дата,
	|	З.Номер КАК Номер,
	|	З.Организация КАК Организация,
	|	З.Партнер КАК Партнер,
	|	З.Контрагент КАК Контрагент,
	|	" + ?(ЕстьКонтактноеЛицо, "З.КонтактноеЛицо", "НЕОПРЕДЕЛЕНО") + " КАК КонтактноеЛицо,
	|	З.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ЗаказКлиента КАК З
	|ГДЕ
	|	З.Дата МЕЖДУ &Начало И &Конец
	|	И НЕ З.ПометкаУдаления");
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("date", ДатаJSON(Выборка.Дата));
		С.Вставить("order_key", Ид(Выборка.Ссылка));
		С.Вставить("order_no", СокрЛП(Выборка.Номер));
		С.Вставить("org", Строка(Выборка.Организация));
		С.Вставить("partner_key", Ид(Выборка.Партнер));
		С.Вставить("contr_key", Ид(Выборка.Контрагент));
		С.Вставить("person_key", ?(ЗначениеЗаполнено(Выборка.КонтактноеЛицо), Ид(Выборка.КонтактноеЛицо), ""));
		С.Вставить("sum", Выборка.Сумма);
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

#КонецОбласти

#Область ПроизводствоАВТОКОМП

// Производство АВТОКОМП (ламинирование профиля) — по документам переработки (18.10.2026).
// Поля взяты из диагностики рабочей базы: ПоступлениеОтПереработчика.Товары, ЗаказПереработчику.Продукция,
// регистр ТоварыПереданныеПереработчику (Количество; АналитикаУчетаНоменклатуры). Цвет = Характеристика.

// Поступило от переработчика (ламинированный профиль) по дням — вид за период prod_in.
Функция ПоступленияОтПереработчика(Начало, Конец)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	Т.Ссылка КАК Документ,
	|	Т.Ссылка.Номер КАК Номер,
	|	Т.Ссылка.Организация КАК Организация,
	|	Т.Ссылка.Партнер КАК Партнер,
	|	Т.ЗаказПереработчику.Номер КАК НомерЗаказа,
	|	Т.Склад КАК Склад,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Номенклатура.Родитель КАК Группа,
	|	Т.Характеристика КАК Цвет,
	|	СУММА(Т.Количество) КАК Количество
	|ИЗ
	|	Документ.ПоступлениеОтПереработчика.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ), Т.Ссылка, Т.Ссылка.Номер, Т.Ссылка.Организация, Т.Ссылка.Партнер,
	|	Т.ЗаказПереработчику.Номер, Т.Склад, Т.Номенклатура, Т.Номенклатура.Родитель, Т.Характеристика");
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("date", ДатаJSON(Выборка.Дата));
		С.Вставить("doc_key", Ид(Выборка.Документ));
		С.Вставить("doc_no", СокрЛП(Выборка.Номер));
		С.Вставить("org", Строка(Выборка.Организация));
		С.Вставить("partner", Строка(Выборка.Партнер));
		С.Вставить("order_no", СокрЛП(Выборка.НомерЗаказа));
		С.Вставить("warehouse", Строка(Выборка.Склад));
		С.Вставить("item", Строка(Выборка.Номенклатура));
		С.Вставить("item_key", Ид(Выборка.Номенклатура));
		С.Вставить("item_group", Строка(Выборка.Группа));
		С.Вставить("color", Строка(Выборка.Цвет));
		С.Вставить("qty", Выборка.Количество);
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Собственное производство (база АВТОКОМП): «Производство без заказа», ТЧ ВыходныеИзделия (в форме — «Продукция»)
// — вид за период prod_out. Участок = Подразделение документа (Участок ламинации / полимерной покраски /
// химической обработки алюминия / маркировки и упаковки). Вес и площадь — из карточки номенклатуры
// (ВесЧислитель/ВесЗнаменатель, ПлощадьЧислитель/ПлощадьЗнаменатель) × количество. Диагностика АВТОКОМП 18.10 21:11.
Функция ВыпускПродукции(Начало, Конец)
	Строки = Новый Массив;
	Если Метаданные.Документы.Найти("ПроизводствоБезЗаказа") = Неопределено Тогда
		Возврат Строки;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	Т.Ссылка КАК Документ,
	|	Т.Ссылка.Номер КАК Номер,
	|	Т.Ссылка.Организация КАК Организация,
	|	Т.Ссылка.Подразделение КАК Подразделение,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Номенклатура.Родитель КАК Группа,
	|	Т.Номенклатура.ЕдиницаИзмерения КАК Ед,
	|	Т.Характеристика КАК Цвет,
	|	Т.Номенклатура.ВесЧислитель КАК ВесЧ,
	|	Т.Номенклатура.ВесЗнаменатель КАК ВесЗ,
	|	Т.Номенклатура.ВесЕдиницаИзмерения КАК ВесЕд,
	|	Т.Номенклатура.ПлощадьЧислитель КАК ПлЧ,
	|	Т.Номенклатура.ПлощадьЗнаменатель КАК ПлЗ,
	|	Т.Номенклатура.ПлощадьЕдиницаИзмерения КАК ПлЕд,
	|	СУММА(Т.Количество) КАК Количество
	|ИЗ
	|	Документ.ПроизводствоБезЗаказа.ВыходныеИзделия КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Ссылка.Дата МЕЖДУ &Начало И &Конец
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Т.Ссылка.Дата, ДЕНЬ), Т.Ссылка, Т.Ссылка.Номер, Т.Ссылка.Организация, Т.Ссылка.Подразделение,
	|	Т.Номенклатура, Т.Номенклатура.Родитель, Т.Номенклатура.ЕдиницаИзмерения, Т.Характеристика,
	|	Т.Номенклатура.ВесЧислитель, Т.Номенклатура.ВесЗнаменатель, Т.Номенклатура.ВесЕдиницаИзмерения,
	|	Т.Номенклатура.ПлощадьЧислитель, Т.Номенклатура.ПлощадьЗнаменатель, Т.Номенклатура.ПлощадьЕдиницаИзмерения
	|ИМЕЮЩИЕ
	|	СУММА(Т.Количество) <> 0");
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("date", ДатаJSON(Выборка.Дата));
		С.Вставить("doc_key", Ид(Выборка.Документ));
		С.Вставить("doc_no", СокрЛП(Выборка.Номер));
		С.Вставить("org", Строка(Выборка.Организация));
		С.Вставить("dept", Строка(Выборка.Подразделение));
		С.Вставить("warehouse", "");
		С.Вставить("item", Строка(Выборка.Номенклатура));
		С.Вставить("item_key", Ид(Выборка.Номенклатура));
		С.Вставить("item_group", Строка(Выборка.Группа));
		С.Вставить("color", Строка(Выборка.Цвет));
		С.Вставить("qty", Выборка.Количество);
		С.Вставить("unit", Строка(Выборка.Ед));
		// вес и площадь всего выпуска строки (в единицах карточки: weight_unit / area_unit)
		С.Вставить("weight", ?(ЗначениеЗаполнено(Выборка.ВесЗ) И Выборка.ВесЗ <> 0, Выборка.Количество * Выборка.ВесЧ / Выборка.ВесЗ, 0));
		С.Вставить("weight_unit", Строка(Выборка.ВесЕд));
		С.Вставить("area", ?(ЗначениеЗаполнено(Выборка.ПлЗ) И Выборка.ПлЗ <> 0, Выборка.Количество * Выборка.ПлЧ / Выборка.ПлЗ, 0));
		С.Вставить("area_unit", Строка(Выборка.ПлЕд));
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Заказы переработчику за год: продукция, срок, сколько уже поступило — снимок prod_orders.
Функция ЗаказыПереработчику()
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.ЗаказПереработчику КАК Заказ,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Цвет,
	|	СУММА(Т.Количество) КАК Количество
	|ПОМЕСТИТЬ Получено
	|ИЗ
	|	Документ.ПоступлениеОтПереработчика.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка.Проведен
	|	И Т.Ссылка.Дата >= &Начало
	|СГРУППИРОВАТЬ ПО
	|	Т.ЗаказПереработчику, Т.Номенклатура, Т.Характеристика
	|;
	|ВЫБРАТЬ
	|	П.Ссылка КАК Заказ,
	|	П.Ссылка.Номер КАК Номер,
	|	П.Ссылка.Дата КАК Дата,
	|	П.Ссылка.Партнер КАК Партнер,
	|	П.Ссылка.Организация КАК Организация,
	|	П.Ссылка.Статус КАК Статус,
	|	П.Номенклатура КАК Номенклатура,
	|	П.Номенклатура.Родитель КАК Группа,
	|	П.Характеристика КАК Цвет,
	|	СУММА(П.Количество) КАК Количество,
	|	МИНИМУМ(П.ДатаПоступления) КАК Срок,
	|	ЕСТЬNULL(МАКСИМУМ(Г.Количество), 0) КАК Получено
	|ИЗ
	|	Документ.ЗаказПереработчику.Продукция КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ Получено КАК Г
	|		ПО П.Ссылка = Г.Заказ И П.Номенклатура = Г.Номенклатура И П.Характеристика = Г.Цвет
	|ГДЕ
	|	П.Ссылка.Проведен
	|	И НЕ П.Отменено
	|	И П.Ссылка.Дата >= &Начало
	|СГРУППИРОВАТЬ ПО
	|	П.Ссылка, П.Ссылка.Номер, П.Ссылка.Дата, П.Ссылка.Партнер, П.Ссылка.Организация, П.Ссылка.Статус,
	|	П.Номенклатура, П.Номенклатура.Родитель, П.Характеристика");
	Запрос.УстановитьПараметр("Начало", ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -12));
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("order_key", Ид(Выборка.Заказ));
		С.Вставить("order_no", СокрЛП(Выборка.Номер));
		С.Вставить("order_date", ДатаJSON(Выборка.Дата));
		С.Вставить("partner", Строка(Выборка.Партнер));
		С.Вставить("org", Строка(Выборка.Организация));
		С.Вставить("status", Строка(Выборка.Статус));
		С.Вставить("item", Строка(Выборка.Номенклатура));
		С.Вставить("item_key", Ид(Выборка.Номенклатура));
		С.Вставить("item_group", Строка(Выборка.Группа));
		С.Вставить("color", Строка(Выборка.Цвет));
		С.Вставить("qty", Выборка.Количество);
		С.Вставить("qty_in", Выборка.Получено);
		С.Вставить("due_date", ?(ЗначениеЗаполнено(Выборка.Срок), ДатаJSON(Выборка.Срок), ""));
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Сырьё у переработчика (передано и ещё не вернулось продукцией) — снимок prod_raw.
Функция СырьеУПереработчика()
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	О.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	О.АналитикаУчетаНоменклатуры.Номенклатура.Родитель КАК Группа,
	|	О.АналитикаУчетаНоменклатуры.Характеристика КАК Цвет,
	|	СУММА(О.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыПереданныеПереработчику.Остатки КАК О
	|СГРУППИРОВАТЬ ПО
	|	О.АналитикаУчетаНоменклатуры.Номенклатура, О.АналитикаУчетаНоменклатуры.Номенклатура.Родитель,
	|	О.АналитикаУчетаНоменклатуры.Характеристика
	|ИМЕЮЩИЕ
	|	СУММА(О.КоличествоОстаток) <> 0");
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("item", Строка(Выборка.Номенклатура));
		С.Вставить("item_key", Ид(Выборка.Номенклатура));
		С.Вставить("item_group", Строка(Выборка.Группа));
		С.Вставить("color", Строка(Выборка.Цвет));
		С.Вставить("qty", Выборка.Количество);
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

#КонецОбласти

#Область ЗакрытиеСделокБ24

// 23.10.2026. Коннектор Битрикс24 4.4.0.3 меняет стадию сделки только при записи самого заказа; закрытие
// заказа оплатой / реализацией / обработкой закрытия сделку не трогает. Раз в 15 минут шлём на портал
// закрытые заказы за последние ДнейНазад дней, портал (app/dealsync.py) переводит их сделки в «Завершена
// успешно» (сделка ищется по ORIGIN_ID = уникальный идентификатор заказа). Коннектор не меняем.
// Регламентное задание ану_ЗакрытиеСделокБ24 — Метод: ану_Аналитика.ану_ЗакрытиеСделокБ24, каждые 900 с,
// «Повторять каждые 1 дн.». Режим на портале: DEAL_SYNC_MODE=test (ничего не меняет) / live.
Процедура ЗакрытьСделкиБ24(ПробныйПрогон = Ложь, ДнейНазад = 120, Счетчики = Неопределено) Экспорт

	Начало = НачалоДня(ТекущаяДатаСеанса() - ДнейНазад * 86400);
	Заказы = Новый Массив;
	Видели = Новый Соответствие;
	Ошибки = Новый Массив;

	// 1) Статус документа «Закрыт»
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	З.Ссылка КАК Ссылка,
	|	З.Номер КАК Номер
	|ИЗ
	|	Документ.ЗаказКлиента КАК З
	|ГДЕ
	|	З.Проведен
	|	И З.Дата >= &Начало
	|	И З.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)");
	Запрос.УстановитьПараметр("Начало", Начало);
	Попытка
		ДобавитьЗаказы(Запрос.Выполнить().Выбрать(), "status_closed", Заказы, Видели);
	Исключение
		Ошибки.Добавить("Статус заказа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// 2) Состояние заказа «Готов к закрытию» / «Закрыт» (оплачен и отгружен, документ ещё не закрыт)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	С.Заказ КАК Ссылка,
	|	С.Заказ.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.СостоянияЗаказовКлиентов КАК С
	|ГДЕ
	|	С.Заказ ССЫЛКА Документ.ЗаказКлиента
	|	И С.Заказ.Дата >= &Начало
	|	И С.Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.ГотовКЗакрытию),
	|		ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.Закрыт))");
	Запрос.УстановитьПараметр("Начало", Начало);
	Попытка
		ДобавитьЗаказы(Запрос.Выполнить().Выбрать(), "ready_to_close", Заказы, Видели);
	Исключение
		Ошибки.Добавить("Состояние заказа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Счетчики <> Неопределено Тогда
		Счетчики.Вставить("deals_close", Заказы.Количество());
	КонецЕсли;

	Порция = Новый Массив;
	Для Каждого З Из Заказы Цикл
		Порция.Добавить(З);
		Если Порция.Количество() = 1000 Тогда
			ОтправитьЗаказыБ24(Порция, ПробныйПрогон, Ошибки);
			Порция = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Порция.Количество() > 0 Или Заказы.Количество() = 0 Тогда
		ОтправитьЗаказыБ24(Порция, ПробныйПрогон, Ошибки);
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		Если Счетчики <> Неопределено Тогда
			Счетчики.Вставить("deals_close_errors", СтрСоединить(Ошибки, "; "));
		Иначе
			ЗаписьЖурналаРегистрации("ANESCOM.ЗакрытиеСделокБ24", УровеньЖурналаРегистрации.Ошибка, , ,
				СтрСоединить(Ошибки, Символы.ПС));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьЗаказы(Выборка, Причина, Заказы, Видели)
	Пока Выборка.Следующий() Цикл
		Ключ = Ид(Выборка.Ссылка);
		Если Ключ = "" Или Видели[Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Видели.Вставить(Ключ, Истина);
		Заказы.Добавить(Новый Структура("guid,no,reason", Ключ, СокрЛП(Выборка.Номер), Причина));
	КонецЦикла;
КонецПроцедуры

Процедура ОтправитьЗаказыБ24(Порция, ПробныйПрогон, Ошибки)
	Данные = Новый Структура("orders,dry_run", Порция, ПробныйПрогон);
	Попытка
		Отправить("deals_close", Данные);
	Исключение
		Ошибки.Добавить("Отправка на портал: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область Отправка

Процедура ОтправитьПорциями(Вид, Строки, Начало, Конец)
	Размер = РазмерПорции();
	Всего = Строки.Количество();
	Номер = 0;
	Пока Истина Цикл
		Порция = Новый Массив;
		Для Инд = Номер * Размер По Мин(Всего, (Номер + 1) * Размер) - 1 Цикл
			Порция.Добавить(Строки[Инд]);
		КонецЦикла;
		Тело = Новый Структура("rows", Порция);
		Если Начало <> Неопределено Тогда
			Тело.Вставить("date_from", ДатаJSON(Начало));
			Тело.Вставить("date_to", ДатаJSON(Конец));
			Тело.Вставить("append", Номер > 0);   // первая порция заменяет весь период
		Иначе
			Тело.Вставить("replace", Номер = 0);  // первая порция заменяет весь снимок
		КонецЕсли;
		Отправить(Вид, Тело);
		Номер = Номер + 1;
		Если Номер * Размер >= Всего Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура Отправить(Вид, Данные)

	Если Не ЗначениеЗаполнено(Токен()) Тогда
		ВызватьИсключение "Не задан токен портала (функция Токен() в ану_Аналитика)";
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Структура") И Не Данные.Свойство("source") Тогда
		Данные.Вставить("source", Источник());
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();

	Если ЛокальныйСервер() Тогда
		Соединение = Новый HTTPСоединение("127.0.0.1", 8096,,,, 120);
	Иначе
		Соединение = Новый HTTPСоединение("edo.anescom.kz", 443,,,, 120, Новый ЗащищенноеСоединениеOpenSSL());
	КонецЕсли;
	Запрос = Новый HTTPЗапрос("/api/analytics/" + Вид);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен());
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Портал ответил " + Ответ.КодСостояния + ": "
			+ Лев(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), 300);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция ДатаJSON(Дата)
	Возврат Формат(Дата, "ДФ=yyyy-MM-dd");
КонецФункции

Функция Ид(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	Исключение
		Возврат Строка(Ссылка);
	КонецПопытки;
КонецФункции

Функция ОписаниеОбъекта(Имя, М)
	О = Новый Структура("name,exists", Имя, М <> Неопределено);
	Если М = Неопределено Тогда
		Возврат О;
	КонецЕсли;
	Для Каждого Коллекция Из СтрРазделить("Измерения,Ресурсы,Реквизиты,ТабличныеЧасти", ",") Цикл
		Попытка
			Элементы = Вычислить("М." + Коллекция);
		Исключение
			Продолжить;
		КонецПопытки;
		Список = Новый Массив;
		Для Каждого Э Из Элементы Цикл
			Если Коллекция = "ТабличныеЧасти" Тогда
				Поля = Новый Массив;
				Для Каждого Р Из Э.Реквизиты Цикл
					Поля.Добавить(Р.Имя);
				КонецЦикла;
				Список.Добавить(Э.Имя + ": " + СтрСоединить(Поля, ","));
			Иначе
				Список.Добавить(Э.Имя + " «" + Э.Синоним + "» (" + СтрЗаменить(Строка(Э.Тип), Символы.ПС, " ") + ")");
			КонецЕсли;
		КонецЦикла;
		О.Вставить(Коллекция, Список);
	КонецЦикла;
	Возврат О;
КонецФункции

Функция СписокНаименований(ПолноеИмя)
	Список = Новый Массив;
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 300 Т.Наименование КАК Имя ИЗ " + ПолноеИмя + " КАК Т ГДЕ НЕ Т.ПометкаУдаления");
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Список.Добавить(Выборка.Имя);
		КонецЦикла;
	Исключение
		Список.Добавить("ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Список;
КонецФункции

