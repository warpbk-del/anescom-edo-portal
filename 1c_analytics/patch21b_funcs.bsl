// ===== Патч 21b: функции (вставить перед «Функция Ч(Значение)») =====
// Пары счетов по проводкам с деньгами (10xx): Дт/Кт, банковский счёт/касса (субконто 1), вид документа — по месяцам.
Функция АудитПарыДенег(Начало, Конец)
	ИмяРег = ИмяРегистраБУ();
	Текст = "ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ) КАК Месяц,
	|	Т.Организация КАК Организация,
	|	Т.СчетДт.Код КАК Дт, Т.СчетКт.Код КАК Кт,
	|	ПРЕДСТАВЛЕНИЕ(Т.СубконтоДт1) КАК СубДт, ПРЕДСТАВЛЕНИЕ(Т.СубконтоКт1) КАК СубКт,
	|	ТИПЗНАЧЕНИЯ(Т.Регистратор) КАК ТипДок,
	|	КОЛИЧЕСТВО(*) КАК Кол, СУММА(Т.Сумма) КАК Сумма,
	|	МАКСИМУМ(Т.Регистратор) КАК Пример
	|ИЗ
	|	РегистрБухгалтерии." + ИмяРег + " КАК Т
	|ГДЕ
	|	Т.Период МЕЖДУ &Начало И &Конец
	|	И (Т.СчетДт.Код ПОДОБНО ""10%"" ИЛИ Т.СчетКт.Код ПОДОБНО ""10%"")
	|	И Т.Активность
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Т.Период, МЕСЯЦ), Т.Организация, Т.СчетДт.Код, Т.СчетКт.Код,
	|	ПРЕДСТАВЛЕНИЕ(Т.СубконтоДт1), ПРЕДСТАВЛЕНИЕ(Т.СубконтоКт1), ТИПЗНАЧЕНИЯ(Т.Регистратор)";
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("month", ДатаJSON(Выборка.Месяц));
		С.Вставить("org", Строка(Выборка.Организация));
		С.Вставить("dt", СокрЛП(Выборка.Дт));
		С.Вставить("kt", СокрЛП(Выборка.Кт));
		С.Вставить("sub_dt", Строка(Выборка.СубДт));
		С.Вставить("sub_kt", Строка(Выборка.СубКт));
		С.Вставить("doc_type", Строка(Выборка.ТипДок));
		С.Вставить("n", Ч(Выборка.Кол));
		С.Вставить("sum", Ч(Выборка.Сумма));
		С.Вставить("sample", Строка(Выборка.Пример));
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

// Проводки по выбранным счетам (коды через запятую) — по документам.
Функция АудитДвиженияСчетов(Начало, Конец, Коды)
	ИмяРег = ИмяРегистраБУ();
	ИмяПлана = Метаданные.РегистрыБухгалтерии[ИмяРег].ПланСчетов.Имя;
	Счета = Новый Массив;
	Для Каждого Код Из СтрРазделить(Коды, ",") Цикл
		Сч = ПланыСчетов[ИмяПлана].НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Сч) Тогда
			Счета.Добавить(Сч);
		КонецЕсли;
	КонецЦикла;
	Текст = "ВЫБРАТЬ
	|	Т.Период КАК Период, Т.Регистратор КАК Док, Т.Организация КАК Организация,
	|	Т.СчетДт.Код КАК Дт, Т.СчетКт.Код КАК Кт,
	|	ПРЕДСТАВЛЕНИЕ(Т.СубконтоДт1) КАК СубДт1, ПРЕДСТАВЛЕНИЕ(Т.СубконтоКт1) КАК СубКт1,
	|	ПРЕДСТАВЛЕНИЕ(Т.ПодразделениеДт) КАК ПодрДт, ПРЕДСТАВЛЕНИЕ(Т.ПодразделениеКт) КАК ПодрКт,
	|	СУММА(Т.Сумма) КАК Сумма, МАКСИМУМ(Т.Содержание) КАК Содержание
	|ИЗ
	|	РегистрБухгалтерии." + ИмяРег + " КАК Т
	|ГДЕ
	|	Т.Период МЕЖДУ &Начало И &Конец И Т.Активность
	|	И (Т.СчетДт В ИЕРАРХИИ (&Счета) ИЛИ Т.СчетКт В ИЕРАРХИИ (&Счета))
	|СГРУППИРОВАТЬ ПО
	|	Т.Период, Т.Регистратор, Т.Организация, Т.СчетДт.Код, Т.СчетКт.Код,
	|	ПРЕДСТАВЛЕНИЕ(Т.СубконтоДт1), ПРЕДСТАВЛЕНИЕ(Т.СубконтоКт1),
	|	ПРЕДСТАВЛЕНИЕ(Т.ПодразделениеДт), ПРЕДСТАВЛЕНИЕ(Т.ПодразделениеКт)";
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Счета", Счета);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		С = Новый Структура;
		С.Вставить("date", Формат(Выборка.Период, "ДФ=yyyy-MM-dd"));
		С.Вставить("doc", Строка(Выборка.Док));
		С.Вставить("org", Строка(Выборка.Организация));
		С.Вставить("dt", СокрЛП(Выборка.Дт));
		С.Вставить("kt", СокрЛП(Выборка.Кт));
		С.Вставить("sub_dt", Строка(Выборка.СубДт1));
		С.Вставить("sub_kt", Строка(Выборка.СубКт1));
		С.Вставить("dept_dt", Строка(Выборка.ПодрДт));
		С.Вставить("dept_kt", Строка(Выборка.ПодрКт));
		С.Вставить("sum", Ч(Выборка.Сумма));
		С.Вставить("text", Лев(Строка(Выборка.Содержание), 150));
		Строки.Добавить(С);
	КонецЦикла;
	Возврат Строки;
КонецФункции

