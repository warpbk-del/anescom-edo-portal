	// ===== Патч 21b (24.10.2026): ОСВ на 30.09.2026, пары счетов денег, движения по выбранным счетам =====
	Конец0930 = КонецДня(Дата(2026, 9, 30));
	Для Каждого Раздел Из СтрРазделить("osv,osv_acc,money_pairs,moves_sel", ",") Цикл
		Попытка
			Если Раздел = "money_pairs" Тогда
				Строки = АудитПарыДенег(Дата(2025, 1, 1), Конец);
				ОтправитьАудит(Раздел, Строки, Дата(2025, 1, 1), Конец);
			ИначеЕсли Раздел = "moves_sel" Тогда
				Строки = АудитДвиженияСчетов(Дата(2024, 12, 1), Конец, "0000,3340,1340,1151,3381,1060,1050,3360,3350,5610");
				ОтправитьАудит(Раздел, Строки, Дата(2024, 12, 1), Конец);
			Иначе
				Строки = АудитОСВ(Дата(2026, 1, 1), Конец0930, Раздел = "osv");
				Раздел = Раздел + "_0930";
				ОтправитьАудит(Раздел, Строки, Дата(2026, 1, 1), Конец0930);
			КонецЕсли;
			Счетчики.Вставить(Раздел, Строки.Количество());
		Исключение
			Ошибки.Добавить(Раздел + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
