// Расширение «ANESCOM: Уведомления об оплате» (префикс ану_). Общий модуль ану_УведомленияОбОплате
// (Сервер, НЕ «Вызов сервера», НЕ глобальный). Безопасный режим расширения — выключен (нужен HTTP).
//
// Чеки (ПКО — наличные, Операция по платёжной карте — эквайринг):
//   Регламентное задание ану_УведомленияПоЧекам (Предопределенное, Использование, каждые 300 с),
//       Метод: ану_УведомленияОбОплате.ПроверитьЧеки — читает новые записи РС «Фискальные операции РК»
//       (ФискальныеОперацииРК есть только в рабочей базе 5.21; запрос строится строкой, поэтому
//       расширение собирается и в копии). Повторно по тому же документу портал не отправляет.
//   ану_ФискальнаяОперацияПриЗаписи (старая подписка на РС ФискальныеОперации) — обработчик пустой, оставлен для совместимости.
//   ану_ПоступлениеБезналаОбработкаПроведения
//       Источник: ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств, Событие: ОбработкаПроведения,
//       Обработчик: ану_УведомленияОбОплате.ПоступлениеБезналаОбработкаПроведения
//       → безнал: только текст, без чека.
//
// Отправка — фоновым заданием, чтобы не задерживать проведение. Сервер (портал ЭДО) сам не шлёт
// повторно по тому же документу и в режиме test пишет только на тестовые номера.

#Область НастройкиПодключения

Функция Сервер()
	Возврат "bot.anescom.kz";
КонецФункции

Функция АдресМетода()
	Возврат "/dogovor/api/payments/notify";
КонецФункции

// Токен = EDO_API_TOKEN из D:\anescom_edo\config.env. Вписывает пользователь.
Функция Токен()
	Возврат "";
КонецФункции

#КонецОбласти

#Область ОбработчикиПодписок

Процедура ФискальнаяОперацияПриЗаписи(Источник, Отказ, Замещение) Экспорт
	// Не используется: в рабочей базе чеки пишутся в РС ФискальныеОперацииРК — см. ПроверитьЧеки().
КонецПроцедуры

// Регламентное задание ану_УведомленияПоЧекам (каждые 5 минут).
Процедура ПроверитьЧеки() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Сейчас = ТекущаяДатаСеанса();
	Последний = Неопределено;
	Попытка
		Последний = ХранилищеОбщихНастроек.Загрузить("ANESCOM.УведомленияОбОплате", "ПоследнийЧек",, "ANESCOM_Служебный");
	Исключение
	КонецПопытки;
	Если ТипЗнч(Последний) <> Тип("Дата") Или Последний < Сейчас - 86400 Тогда
		Последний = Сейчас - 900; // первый запуск — только чеки за последние 15 минут
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 200
		|	Ф.ДокументОснование КАК ДокументОснование,
		|	Ф.ДатаВремяЧека КАК ДатаВремяЧека,
		|	Ф.НомерЧека КАК НомерЧека,
		|	Ф.ОбщаяСуммаЧека КАК ОбщаяСуммаЧека,
		|	Ф.РегистрационныйНомерКассы КАК РегистрационныйНомерКассы,
		|	Ф.АвтономныйРежимРаботыКассы КАК АвтономныйРежимРаботыКассы
		|ИЗ
		|	РегистрСведений.ФискальныеОперацииРК КАК Ф
		|ГДЕ
		|	Ф.ДатаВремяЧека > &С
		|	И Ф.ОбщаяСуммаЧека > 0
		|	И (Ф.ДокументОснование ССЫЛКА Документ.ПриходныйКассовыйОрдер
		|		ИЛИ Ф.ДокументОснование ССЫЛКА Документ.ОперацияПоПлатежнойКарте)
		|УПОРЯДОЧИТЬ ПО
		|	ДатаВремяЧека");
	// Перекрытие 10 минут: запись чека может появиться чуть позже его времени; дубли отсекает портал
	Запрос.УстановитьПараметр("С", Последний - 600);
	Выборка = Запрос.Выполнить().Выбрать();

	Максимум = Последний;
	Пока Выборка.Следующий() Цикл
		Попытка
			Документ = Выборка.ДокументОснование;
			Вид = ?(ТипЗнч(Документ) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер"), "cash", "card");
			Данные = ДанныеОплаты(Документ, Вид);
			Если Данные <> Неопределено Тогда
				// НомерЧека = фискальный признак — по нему ссылка на чек ОФД (проверено 18.10.2026)
				Данные.Вставить("check_no", СокрЛП(Выборка.НомерЧека));
				Данные.Вставить("check_datetime", Формат(Выборка.ДатаВремяЧека, "ДФ=yyyy-MM-ddTHH:mm:ss"));
				Данные.Вставить("rnk", СокрЛП(Выборка.РегистрационныйНомерКассы));
				Данные.Вставить("amount", Выборка.ОбщаяСуммаЧека);
				Данные.Вставить("offline", Выборка.АвтономныйРежимРаботыКассы = Истина);
				Отправить(Данные);
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации("ANESCOM.УведомлениеОбОплате", УровеньЖурналаРегистрации.Ошибка,,,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Если Выборка.ДатаВремяЧека > Максимум Тогда
			Максимум = Выборка.ДатаВремяЧека;
		КонецЕсли;
	КонецЦикла;

	Попытка
		ХранилищеОбщихНастроек.Сохранить("ANESCOM.УведомленияОбОплате", "ПоследнийЧек", Максимум,, "ANESCOM_Служебный");
	Исключение
		ЗаписьЖурналаРегистрации("ANESCOM.УведомлениеОбОплате", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ПоступлениеБезналаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт

	Если Отказ Или ОбменДанными(Источник) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Данные = ДанныеОплаты(Источник.Ссылка, "bank", Источник);
		Если Данные <> Неопределено Тогда
			ЗапуститьОтправку(Данные);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ANESCOM.УведомлениеОбОплате", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область Данные

Функция ОбменДанными(Источник)
	Попытка
		Возврат Источник.ОбменДанными.Загрузка;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Объект — для безнала берём данные из проводимого объекта (ссылка ещё может быть не записана).
Функция ДанныеОплаты(Ссылка, Вид, Объект = Неопределено)

	Если Объект = Неопределено Тогда
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	// Только оплата от клиента (возвраты, выдачи и прочие операции — не уведомляем)
	Если Объект.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента Тогда
		Возврат Неопределено;
	КонецЕсли;

	Партнер = Неопределено;
	Заказ = Неопределено;
	Для Каждого СтрокаТЧ Из Объект.РасшифровкаПлатежа Цикл
		Если Партнер = Неопределено И ЗначениеЗаполнено(СтрокаТЧ.Партнер) Тогда
			Партнер = СтрокаТЧ.Партнер;
		КонецЕсли;
		Если Заказ = Неопределено И ЗначениеЗаполнено(СтрокаТЧ.Заказ) Тогда
			Заказ = СтрокаТЧ.Заказ;
		КонецЕсли;
	КонецЦикла;

	ИмяКлиента = ?(ЗначениеЗаполнено(Партнер), Строка(Партнер), Строка(Объект.Контрагент));
	// Общие розничные партнёры («Покупатель розница …») — не уведомляем: телефон у них не клиента
	Если СтрНачинаетсяС(НРег(ИмяКлиента), "покупатель розница") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Телефоны = Новый Массив;
	ДобавитьТелефоны(Телефоны, Партнер);
	ДобавитьТелефоны(Телефоны, Объект.Контрагент);
	Если Телефоны.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("doc_key", Строка(Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("doc_title", Строка(Ссылка));
	Данные.Вставить("pay_kind", Вид);
	Данные.Вставить("client_name", ИмяКлиента);
	Данные.Вставить("phone", СтрСоединить(Телефоны, ";"));
	Данные.Вставить("amount", Объект.СуммаДокумента);
	Если ЗначениеЗаполнено(Заказ) Тогда
		Попытка
			Данные.Вставить("order_no", Строка(Заказ.Номер));
		Исключение
			Данные.Вставить("order_no", Строка(Заказ));
		КонецПопытки;
	КонецЕсли;
	Возврат Данные;

КонецФункции

Процедура ДобавитьТелефоны(Телефоны, Владелец)

	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат;
	КонецЕсли;
	ИмяТаблицы = Владелец.Метаданные().ПолноеИмя() + ".КонтактнаяИнформация";
	Запрос = Новый Запрос(
		"ВЫБРАТЬ КИ.Представление КАК Представление
		|ИЗ " + ИмяТаблицы + " КАК КИ
		|ГДЕ КИ.Ссылка = &Владелец И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)");
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Представление) И Телефоны.Найти(Выборка.Представление) = Неопределено Тогда
			Телефоны.Добавить(Выборка.Представление);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Отправка

Процедура ЗапуститьОтправку(Данные)

	Параметры = Новый Массив;
	Параметры.Добавить(Данные);
	ФоновыеЗадания.Выполнить("ану_УведомленияОбОплате.Отправить", Параметры,,
		"ANESCOM: уведомление об оплате " + Данные.doc_title);

КонецПроцедуры

// Вызывается фоновым заданием. Чек в «Фискальные операции» пишется сразу после пробития,
// HTTP-запрос короткий (таймаут 20 с); при ошибке — запись в журнал регистрации.
Процедура Отправить(Данные) Экспорт

	Если Не ЗначениеЗаполнено(Токен()) Тогда
		ЗаписьЖурналаРегистрации("ANESCOM.УведомлениеОбОплате", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не задан токен портала — уведомление не отправлено: " + Данные.doc_title);
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();

	Соединение = Новый HTTPСоединение(Сервер(), 443,,,, 20, Новый ЗащищенноеСоединениеOpenSSL());
	Запрос = Новый HTTPЗапрос(АдресМетода());
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен());
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Уровень = ?(Ответ.КодСостояния = 200, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка);
	ЗаписьЖурналаРегистрации("ANESCOM.УведомлениеОбОплате", Уровень,,,
		Данные.doc_title + " → " + Ответ.КодСостояния + ": " + Лев(Текст, 500));

КонецПроцедуры

#КонецОбласти
