// ANESCOM 21-32: мониторы на начальной странице у всех пользователей.
// 1) СохранитьБэкап — настройки начальной страницы ВСЕХ пользователей сохраняются в ХранилищеОбщихНастроек
//    (ключ "ану_БэкапНачСтраницы", у пользователя, который запускает обработку; копия на каждый запуск + "Последний").
// 2) УбратьМониторы — из состава форм убираются формы, имя которых содержит маску; остальное не трогается.
// 3) Вернуть — восстановить всё из последнего бэкапа (у кого настроек не было — настройки удаляются, т.е. снова по умолчанию).
// Изменения видны пользователю после перезапуска 1С.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МаскиМониторов = "Монитор";
	Журнал = "Порядок: Показать состав → 1. Сохранить → 2. Убрать. Откат: «Вернуть как было».";
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючОбъекта()
	Возврат "Общее/НастройкиНачальнойСтраницы";
КонецФункции

&НаСервереБезКонтекста
Функция КлючБэкапа()
	Возврат "ану_БэкапНачСтраницы";
КонецФункции

&НаСервере
Функция ЭтоМонитор(ИмяФормы)
	Для Каждого М Из СтрРазделить(МаскиМониторов, ",;", Ложь) Цикл
		М = НРег(СокрЛП(М));
		Если М <> "" И СтрНайти(НРег(ИмяФормы), М) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервереБезКонтекста
Функция Пользователи()
	Возврат ПользователиИнформационнойБазы.ПолучитьПользователей();
КонецФункции

&НаСервере
Функция ОписаниеКолонки(Колонка)
	Части = Новый Массив;
	Для Каждого Ф Из Колонка Цикл
		Части.Добавить(?(ЭтоМонитор(Ф), "[М] ", "") + Ф);
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");
КонецФункции

&НаСервере
Процедура ПоказатьСоставНаСервере()
	Стр = Новый Массив;
	Для Каждого П Из Пользователи() Цикл
		Н = ХранилищеСистемныхНастроек.Загрузить(КлючОбъекта(), "", , П.Имя);
		Если Н = Неопределено Тогда
			Стр.Добавить(П.Имя + ": (по умолчанию)");
			Продолжить;
		КонецЕсли;
		С = Н.ПолучитьСоставФорм();
		Стр.Добавить(П.Имя + ": Л: " + ОписаниеКолонки(С.ЛеваяКолонка) + " | П: " + ОписаниеКолонки(С.ПраваяКолонка));
	КонецЦикла;
	Журнал = СтрСоединить(Стр, Символы.ПС);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСостав(Команда)
	ПоказатьСоставНаСервере();
КонецПроцедуры

&НаСервере
Процедура СохранитьБэкапНаСервере()
	Бэкап = Новый Соответствие;
	Всего = 0; СНастройками = 0;
	Для Каждого П Из Пользователи() Цикл
		Н = ХранилищеСистемныхНастроек.Загрузить(КлючОбъекта(), "", , П.Имя);
		Бэкап.Вставить(П.Имя, Н);
		Всего = Всего + 1;
		Если Н <> Неопределено Тогда СНастройками = СНастройками + 1; КонецЕсли;
	КонецЦикла;
	Метка = Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMddHHmmss");
	ХранилищеОбщихНастроек.Сохранить(КлючБэкапа(), Метка, Бэкап);
	ХранилищеОбщихНастроек.Сохранить(КлючБэкапа(), "Последний", Бэкап);
	// проверка, что сохранилось
	Пров = ХранилищеОбщихНастроек.Загрузить(КлючБэкапа(), "Последний");
	Если Пров = Неопределено Или Пров.Количество() <> Всего Тогда
		ВызватьИсключение "Бэкап не прочитался обратно — ничего не меняйте";
	КонецЕсли;
	Журнал = "Бэкап сохранён (" + Метка + "): пользователей " + Всего + ", с собственными настройками " + СНастройками + ".";
КонецПроцедуры

&НаКлиенте
Процедура СохранитьБэкап(Команда)
	СохранитьБэкапНаСервере();
КонецПроцедуры

&НаСервере
Функция БезМониторов(Колонка, Убрано)
	Рез = Новый Массив;
	Для Каждого Ф Из Колонка Цикл
		Если ЭтоМонитор(Ф) Тогда
			Убрано.Добавить(Ф);
		Иначе
			Рез.Добавить(Ф);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

&НаСервере
Процедура УбратьМониторыНаСервере()
	Бэкап = ХранилищеОбщихНастроек.Загрузить(КлючБэкапа(), "Последний");
	Если Бэкап = Неопределено Тогда
		ВызватьИсключение "Сначала «1. Сохранить текущие настройки всех»";
	КонецЕсли;
	Стр = Новый Массив; Изменено = 0;
	Для Каждого П Из Пользователи() Цикл
		Н = ХранилищеСистемныхНастроек.Загрузить(КлючОбъекта(), "", , П.Имя);
		Если Н = Неопределено Тогда
			Н = Новый НастройкиНачальнойСтраницы; // состав по умолчанию из конфигурации
		КонецЕсли;
		С = Н.ПолучитьСоставФорм();
		Убрано = Новый Массив;
		Л = БезМониторов(С.ЛеваяКолонка, Убрано);
		Пр = БезМониторов(С.ПраваяКолонка, Убрано);
		Если Убрано.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		НовыйС = Новый СоставФормНачальнойСтраницы;
		Для Каждого Ф Из Л Цикл НовыйС.ЛеваяКолонка.Добавить(Ф); КонецЦикла;
		Для Каждого Ф Из Пр Цикл НовыйС.ПраваяКолонка.Добавить(Ф); КонецЦикла;
		Н.УстановитьСоставФорм(НовыйС);
		ХранилищеСистемныхНастроек.Сохранить(КлючОбъекта(), "", Н, , П.Имя);
		Изменено = Изменено + 1;
		Стр.Добавить(П.Имя + ": убрано " + СтрСоединить(Убрано, ", "));
	КонецЦикла;
	Стр.Вставить(0, "Изменено пользователей: " + Изменено + " (видно после перезапуска 1С).");
	Журнал = СтрСоединить(Стр, Символы.ПС);
КонецПроцедуры

&НаКлиенте
Процедура УбратьМониторы(Команда)
	УбратьМониторыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВернутьНаСервере()
	Бэкап = ХранилищеОбщихНастроек.Загрузить(КлючБэкапа(), "Последний");
	Если Бэкап = Неопределено Тогда
		ВызватьИсключение "Бэкап не найден";
	КонецЕсли;
	Вернули = 0;
	Для Каждого КЗ Из Бэкап Цикл
		Если КЗ.Значение = Неопределено Тогда
			ХранилищеСистемныхНастроек.Удалить(КлючОбъекта(), "", КЗ.Ключ);
		Иначе
			ХранилищеСистемныхНастроек.Сохранить(КлючОбъекта(), "", КЗ.Значение, , КЗ.Ключ);
		КонецЕсли;
		Вернули = Вернули + 1;
	КонецЦикла;
	Журнал = "Восстановлено из бэкапа: " + Вернули + " пользователей (видно после перезапуска 1С).";
КонецПроцедуры

&НаКлиенте
Процедура Вернуть(Команда)
	ВернутьНаСервере();
КонецПроцедуры
